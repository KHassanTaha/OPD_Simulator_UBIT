<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OpdSimulator.App.App"
             RequestedThemeVariant="Light">
    <Application.Styles>
        <FluentTheme/>
        <!-- Button/text stock styles for reusable controls (no raw colours —
             every token comes from Theme.axaml). -->
        <StyleInclude Source="avares://OpdSimulator.App/Assets/ControlStyles.axaml"/>
        <!-- Global tooltip delay: 500 ms hover delay (AGENTS §16.2). -->
        <Style Selector="ToolTip">
            <Setter Property="ShowDelay" Value="500"/>
        </Style>
    </Application.Styles>

    <!-- Theme.axaml is the single source of colours/fonts/spacing/shadows
         (AGENTS §16.3); Motion.axaml owns every animation duration. Hex
         values appear in exactly one file. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://OpdSimulator.App/Assets/Theme.axaml"/>
                <ResourceInclude Source="avares://OpdSimulator.App/Assets/Motion.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>