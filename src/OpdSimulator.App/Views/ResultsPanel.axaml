<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:OpdSimulator.App.Controls"
             xmlns:vm="using:OpdSimulator.App.ViewModels"
             xmlns:services="using:OpdSimulator.App.Services"
             xmlns:views="using:OpdSimulator.App.Views"
             x:DataType="vm:ResultsPanelViewModel"
             x:Class="OpdSimulator.App.Views.ResultsPanel">

    <!-- Phase-5 results panel (Simulation tab, right column). Layout contract:
         welcome card until any run is attempted; afterwards the chosen widgets
         inside a scrollable stack. Widget order is stable: metrics →
         utilisation (6c.4) → queue length (6c.5) → waiting-time histogram
         (6c.5) → chi-square → simulation verification (8B) → analytical
         validation (8C) → trace (the data preview moved to the Input tab in
         Phase 7D). Phase 8D.1 groups the widgets under headings (Performance
         Measures, Server Performance, Charts, Statistical Validation, Simulation
         Verification, Analytical Validation); the per-stage table shares the
         metrics card, so it carries no separate "Stage Performance" heading
         (8D.1: do not add a redundant heading for a merged table). 8Q.4
         (D-184) removed "Event Trace" from that list: it is no longer a group
         inside the scroll area but a pinned panel in grid row 2, always visible
         and not user-toggleable (FR-UI-35). -->
    <Grid>

        <!-- Welcome card (FR-UI-5). Content must be bound or the template
             never instantiates the card (5c welcome-card bug, part 3). -->
        <ContentControl IsVisible="{Binding IsWelcomeVisible}"
                        Content="{Binding Welcome}">
            <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:WelcomeCardViewModel">
                    <views:WelcomeCard/>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

        <!-- Results once a run starts. Header + widget picker stay pinned; the
             widgets themselves scroll (5c.1). -->
        <Grid IsVisible="{Binding HasRun}" RowDefinitions="Auto,*,Auto">
            <StackPanel Margin="16,16,16,0" Spacing="{DynamicResource SpaceM}">

            <!-- Run header + customise toggle. -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding RunSummary}"
                               FontSize="{DynamicResource FontSizeTitle}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextPrimary}"/>
                    <TextBlock Text="{Binding EffectiveExitText}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource BrushTextSecondary}"/>
                    <TextBlock Text="{Binding EffectiveBypassText}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource BrushTextSecondary}"/>
                    <!-- Which weekdays the requested days resolved to (FR-SIM-12).
                         Hidden for a horizon run, which has no sessions. -->
                    <TextBlock x:Name="SessionSummaryText"
                               Text="{Binding SessionSummaryText}"
                               IsVisible="{Binding HasSessionSummary}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource BrushTextSecondary}"/>
                </StackPanel>
                <ToggleButton Grid.Column="1"
                              x:Name="CustomiseToggle"
                              Content="Customise results"
                              Margin="0,0,0,4"
                              VerticalAlignment="Top"
                              Click="OnCustomiseToggled"
                              ToolTip.Tip="Choose which result widgets are visible (FR-UI-14)"/>
            </Grid>

            <!-- Widget-visibility chooser. -->
            <Border x:Name="WidgetPicker"
                    IsVisible="False"
                    Background="{DynamicResource BrushBackgroundAlt}"
                    CornerRadius="{DynamicResource CornerRadiusM}"
                    Padding="{DynamicResource ThicknessSpaceM}">
                <StackPanel Spacing="{DynamicResource SpaceS}">
                    <TextBlock Text="Visible widgets"
                               FontSize="{DynamicResource FontSizeCaption}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextSecondary}"
                               ToolTip.Tip="Widget visibility is remembered; configuration and results are not (FR-UI-21)"/>
                    <UniformGrid Columns="2">
                        <CheckBox IsChecked="{Binding ShowMetrics, Mode=TwoWay}" Content="Metrics"/>
                        <CheckBox IsChecked="{Binding ShowChiSquare, Mode=TwoWay}" Content="Chi-square"/>
                        <CheckBox IsChecked="{Binding ShowUtilisation, Mode=TwoWay}" Content="Utilisation"/>
                        <CheckBox IsChecked="{Binding ShowQueueLength, Mode=TwoWay}" Content="Queue length"/>
                        <CheckBox IsChecked="{Binding ShowWaitHistogram, Mode=TwoWay}" Content="Wait histogram"/>
                        <CheckBox IsChecked="{Binding ShowSimulationVerification, Mode=TwoWay}" Content="Simulation verification"/>
                        <CheckBox IsChecked="{Binding ShowAnalyticalValidation, Mode=TwoWay}" Content="Analytical validation"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
            </StackPanel>

            <!-- Scrollable widget area (5c.1): metrics, utilisation, chi-square
                 scroll here; the selector row above and the event trace below
                 stay pinned. The data preview moved to the Input tab in Phase 7D.
                 8Q.4 (D-184): the trace left this ScrollViewer for grid row 2, so
                 "scroll here" no longer includes it. -->
            <!-- Phase 8S (D-195): the 120 px floor is what the owner review asked
                 for. Row 1 is a * row between two Auto rows, so on a short window it
                 absorbs every pixel the pinned rows do not want — measured at 101 px
                 at a 420 px window, which is a strip of widgets rather than a
                 readable area. The floor guarantees a usable middle, and because the
                 two pinned rows are Auto and capped, the window scrolls rather than
                 crushing this row further. -->
            <ScrollViewer x:Name="WidgetScroller"
                          Grid.Row="1"
                          MinHeight="120"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="16" Spacing="{DynamicResource SpaceM}">

            <!-- Running progress. -->
            <StackPanel Spacing="4" IsVisible="{Binding IsBusy}">
                <ProgressBar IsIndeterminate="True"/>
                <TextBlock Text="{Binding StatusText}"
                           FontSize="{DynamicResource FontSizeCaption}"
                           Foreground="{DynamicResource BrushTextMuted}"/>
            </StackPanel>

            <!-- Run-refusal banner (G3/G4, 5-F): clean message, never a stack trace. -->
            <controls:ErrorBanner Message="{Binding RunError}"
                                  IsVisible="{Binding HasError}"
                                  ToolTip.Tip="The simulator did not run; read the message and adjust the configuration."/>

            <!-- Group heading: Overview (Phase 8D.1). Phase 8M (D-164) turns it
                 into a two-column row so the "View Calculations" action can sit
                 on the same line as the heading it belongs to, right-aligned. -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,24,0,8">
                <TextBlock Text="Performance Measures"
                           FontSize="{DynamicResource FontSizeTitle}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushTextPrimary}"/>
                <Button Grid.Column="1"
                        Content="View Calculations"
                        Classes="GhostButton"
                        Command="{Binding ShowCalculationsCommand}"
                        IsVisible="{Binding HasCalculations}"
                        VerticalAlignment="Center"
                        ToolTip.Tip="Show the formulas and inputs behind every number on this tab (Phase 8M)."/>
            </Grid>

            <!-- Metrics widget (FR-STAT-6/7). -->
            <Border IsVisible="{Binding ShowMetrics}"
                    Background="{DynamicResource BrushBackgroundPanel}"
                    BorderBrush="{DynamicResource BrushBorderDefault}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CornerRadiusM}"
                    Padding="{DynamicResource ThicknessSpaceM}">
                <StackPanel Spacing="{DynamicResource SpaceM}">
                    <TextBlock Text="System totals"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextPrimary}"/>
                    <ItemsControl ItemsSource="{Binding SystemMetrics}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MetricRow">
                                <Grid ColumnDefinitions="170,Auto" ColumnSpacing="8" Margin="0,2">
                                    <TextBlock Text="{Binding Label}"
                                               FontSize="{DynamicResource FontSizeCaption}"
                                               Foreground="{DynamicResource BrushTextSecondary}"
                                               TextAlignment="Left"/>
                                    <!-- A label:value list, not a listing table: no
                                         header row and no shared column set, so the
                                         serial-number rule does not apply (FR-UI-36).
                                         D-187 right-aligns numeric columns so their
                                         decimals line up, but that only works when
                                         the column is shared. Here each row is its
                                         own Grid, so an Auto column is sized by its
                                         own value and the two never align anyway —
                                         while a * column plus Right pushed every
                                         value to the panel's far edge, metres from
                                         its label. Left-aligned in an Auto column
                                         the value sits beside its label, which is
                                         what a label:value list is for. The four
                                         real listing tables keep right-alignment. -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Value}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrushTextPrimary}"
                                               TextAlignment="Left"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Per stage"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextPrimary}"/>
                    <!-- The "#" column is the 8Q.5 serial-number rule, applied here
                         because this is the per-stage listing (Phase 8Q.3). -->
                    <Grid ColumnDefinitions="30,86,52,40,58,52,56,64,64,64" ColumnSpacing="8">
                        <TextBlock Text="#" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushTextMuted}" TextAlignment="Right"/>
                        <TextBlock Grid.Column="1" Text="Stage" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushTextMuted}" TextAlignment="Left"/>
                        <TextBlock Grid.Column="2" Text="λ" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushTextMuted}" TextAlignment="Right"/>
                        <TextBlock Grid.Column="3" Text="c" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushTextMuted}" TextAlignment="Right"/>
                        <TextBlock Grid.Column="4" Text="μ" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushTextMuted}" TextAlignment="Right"/>
                        <TextBlock Grid.Column="5" Text="ρ" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushTextMuted}" TextAlignment="Right"/>
                        <TextBlock Grid.Column="6" Text="Served" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushTextMuted}" TextAlignment="Right"/>
                        <TextBlock Grid.Column="7" Text="Wait (min)" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushTextMuted}" TextAlignment="Right"/>
                        <TextBlock Grid.Column="8" Text="Queue" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushTextMuted}" TextAlignment="Right"/>
                        <TextBlock Grid.Column="9" Text="Util." FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushTextMuted}" TextAlignment="Right"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding StageRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:StageMetricRow">
                                <Grid ColumnDefinitions="30,86,52,40,58,52,56,64,64,64" ColumnSpacing="8" Margin="0,2">
                                    <TextBlock Text="{Binding SerialNumber}"
                                               Foreground="{DynamicResource BrushTextMuted}"
                                               TextAlignment="Right"/>
                                    <TextBlock Grid.Column="1" Text="{Binding StageName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextAlignment="Left"/>
                                    <TextBlock Grid.Column="2" Text="{Binding ArrivalRate}" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Servers}" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="4" Text="{Binding ServiceRate}" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="5" Text="{Binding Rho}" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="6" Text="{Binding Served}" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="7" Text="{Binding Wait}" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="8" Text="{Binding Queue}" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="9" Text="{Binding Utilisation}" TextAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Backlog and drain (D-191). What the admitted load left behind
                         when arrivals stopped, and how long each stage took to clear
                         it. A "#" column per the 8Q.5 listing rule, and a Basis
                         column so a multi-day average is never read as one day. -->
                    <StackPanel Spacing="{DynamicResource SpaceS}" Margin="0,12,0,0">
                        <TextBlock Text="Backlog and drain"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                        <TextBlock Text="{Binding TotalDrainText}"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   TextWrapping="Wrap"/>
                        <Grid ColumnDefinitions="30,86,*,64,*" ColumnSpacing="8">
                            <TextBlock Text="#" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushTextMuted}" TextAlignment="Right"/>
                            <TextBlock Grid.Column="1" Text="Stage" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushTextMuted}" TextAlignment="Left"/>
                            <TextBlock Grid.Column="2" Text="Backlog at close" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushTextMuted}" TextAlignment="Left"/>
                            <TextBlock Grid.Column="3" Text="Drain (min)" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushTextMuted}" TextAlignment="Right"/>
                            <TextBlock Grid.Column="4" Text="Basis" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushTextMuted}" TextAlignment="Left"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding BacklogDrainRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:BacklogDrainRow">
                                    <Grid ColumnDefinitions="30,86,*,64,*" ColumnSpacing="8" Margin="0,2">
                                        <TextBlock Text="{Binding SerialNumber}"
                                                   Foreground="{DynamicResource BrushTextMuted}"
                                                   TextAlignment="Right"/>
                                        <TextBlock Grid.Column="1" Text="{Binding StageName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextAlignment="Left"/>
                                        <TextBlock Grid.Column="2" Text="{Binding BacklogAtClose}" TextAlignment="Left"/>
                                        <TextBlock Grid.Column="3" Text="{Binding DrainMinutes}" TextAlignment="Right"/>
                                        <TextBlock Grid.Column="4" Text="{Binding Basis}"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   TextAlignment="Left"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Stability (Phase 8Q.3, D-183). Hidden until a run
                         exists, because a verdict about a run that has not
                         happened is not a verdict. The band name is rendered as
                         text AND colour, never colour alone (AGENTS §16.9). -->
                    <StackPanel Spacing="{DynamicResource SpaceS}"
                                IsVisible="{Binding HasStability}">
                        <TextBlock Text="Stability"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                        <TextBlock Text="{Binding BottleneckCaption}"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                        <ItemsControl ItemsSource="{Binding StabilityRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:StabilityRow">
                                    <Grid ColumnDefinitions="86,64,*" ColumnSpacing="8" Margin="0,2">
                                        <TextBlock Text="{Binding StageName}" TextTrimming="CharacterEllipsis" TextAlignment="Left"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Rho}" TextAlignment="Right"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Verdict}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding BandBrush}"
                                                   TextAlignment="Left"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Group heading: Server Performance (Phase 8D.1). -->
            <TextBlock Text="Server Performance"
                       FontSize="{DynamicResource FontSizeTitle}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushTextPrimary}"
                       Margin="0,24,0,8"/>

            <!-- Per-server utilisation widget (FR-STAT-7, Phase 6c.4): bar per
                 server, green or amber by imbalance; thin stage-average reference
                 line; empty state until a run finishes. -->
            <Border IsVisible="{Binding ShowUtilisation}"
                    Background="{DynamicResource BrushBackgroundPanel}"
                    BorderBrush="{DynamicResource BrushBorderDefault}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CornerRadiusM}"
                    Padding="{DynamicResource ThicknessSpaceM}">
                <StackPanel Spacing="{DynamicResource SpaceS}">
                    <TextBlock Text="Per-server utilisation"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextPrimary}"/>
                    <TextBlock Text="{Binding UtilisationCaption}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource BrushTextSecondary}"/>
                    <TextBlock Text="Run a simulation to see utilisation."
                               IsVisible="{Binding ShowUtilisationEmptyState}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource BrushTextMuted}"/>
                    <ContentControl IsVisible="{Binding HasUtilisationChart}"
                                    Content="{Binding UtilisationChart}"/>
                </StackPanel>
            </Border>

            <!-- Group heading: Charts (Phase 8D.1) — covers queue length and the
                 waiting-time histogram below. -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,24,0,8">
                <TextBlock Text="Charts"
                           FontSize="{DynamicResource FontSizeTitle}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushTextPrimary}"/>
                <!-- Stage colour legend (Phase 8M, D-163, FR-UI-27). Generated
                     from the run's own stage list, so it cannot fall out of step
                     with the series the charts actually drew. -->
                <ItemsControl Grid.Column="1"
                              ItemsSource="{Binding StageLegend}"
                              IsVisible="{Binding HasQueueLengthChart}"
                              VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpaceM}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:StageLegendItem">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="12" Height="12"
                                        CornerRadius="2"
                                        Background="{Binding Swatch}"
                                        VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding StageName}"
                                           FontSize="{DynamicResource FontSizeCaption}"
                                           Foreground="{DynamicResource BrushTextSecondary}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- Queue-length-over-time widget (FR-UI-4 P2, Phase 6c.5): one line
                 per stage, downsampled ≤ 2000 points; empty state until a run. -->
            <Border IsVisible="{Binding ShowQueueLength}"
                    Background="{DynamicResource BrushBackgroundPanel}"
                    BorderBrush="{DynamicResource BrushBorderDefault}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CornerRadiusM}"
                    Padding="{DynamicResource ThicknessSpaceM}">
                <StackPanel Spacing="{DynamicResource SpaceS}">
                    <TextBlock Text="Queue length over time"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextPrimary}"/>
                    <TextBlock Text="{Binding QueueLengthCaption}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource BrushTextSecondary}"/>
                    <TextBlock Text="Run a simulation to see queue length over time."
                               IsVisible="{Binding ShowQueueLengthEmptyState}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource BrushTextMuted}"/>
                    <ContentControl IsVisible="{Binding HasQueueLengthChart}"
                                    Content="{Binding QueueLengthChart}"/>
                </StackPanel>
            </Border>

            <!-- Waiting-time histogram widget (FR-UI-4 P2, Phase 6c.5): one stage
                 at a time via a searchable dropdown; optional log-scale Y axis. -->
            <Border IsVisible="{Binding ShowWaitHistogram}"
                    Background="{DynamicResource BrushBackgroundPanel}"
                    BorderBrush="{DynamicResource BrushBorderDefault}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CornerRadiusM}"
                    Padding="{DynamicResource ThicknessSpaceM}">
                <StackPanel Spacing="{DynamicResource SpaceS}">
                    <TextBlock Text="Waiting-time distribution"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextPrimary}"/>
                    <TextBlock Text="{Binding WaitHistogramCaption}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource BrushTextSecondary}"/>
                    <StackPanel Spacing="{DynamicResource SpaceS}"
                                IsVisible="{Binding HasWaitHistogramChart}">
                        <controls:SearchableDropdown Label="Stage"
                                                     Placeholder="Choose a stage…"
                                                     Tooltip="The stage whose waiting-time histogram is shown (one stage at a time; resets to the first on every run)"
                                                     Items="{Binding WaitStageNames}"
                                                     SelectedItem="{Binding SelectedWaitStage, Mode=TwoWay}"
                                                     HelpAnchor="waiting-time-histogram"/>
                        <CheckBox IsChecked="{Binding IsWaitLogScale, Mode=TwoWay}"
                                  Content="Log-scale Y axis"
                                  ToolTip.Tip="Use a base-10 logarithmic Y axis for the patient-count bins; helps read long tail bins with very small counts"/>
                    </StackPanel>
                    <TextBlock Text="Run a simulation to see the waiting-time distribution."
                               IsVisible="{Binding ShowWaitHistogramEmptyState}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource BrushTextMuted}"/>
                    <ContentControl IsVisible="{Binding HasWaitHistogramChart}"
                                    Content="{Binding WaitHistogramChart}"/>
                </StackPanel>
            </Border>

            <!-- Group heading: Statistical Validation (Phase 8D.1) — the
                 input-side chi-square table below. -->
            <TextBlock Text="Statistical Validation"
                       FontSize="{DynamicResource FontSizeTitle}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushTextPrimary}"
                       Margin="0,24,0,8"/>

            <!-- Chi-square widget (FR-STAT-8). -->
            <Border IsVisible="{Binding ShowChiSquare}"
                    Background="{DynamicResource BrushBackgroundPanel}"
                    BorderBrush="{DynamicResource BrushBorderDefault}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CornerRadiusM}"
                    Padding="{DynamicResource ThicknessSpaceM}">
                <StackPanel Spacing="{DynamicResource SpaceS}">
<TextBlock Text="{Binding ChiSquareCaption}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushTextPrimary}"/>
                    <!-- Phase 8Q.5 (FR-UI-36): serial column added, numeric
                         columns (χ², df, p) right-aligned. The header reads "#",
                         matching the per-stage table (owner ruling 2026-10-03):
                         every listing table on this panel numbers its rows the
                         same way, so a reader learns it once. -->
                    <Grid ColumnDefinitions="30,130,110,72,46,72,*" ColumnSpacing="8">
                        <TextBlock Text="#" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushTextMuted}" TextAlignment="Right"/>
                        <TextBlock Grid.Column="1" Text="Series" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushTextMuted}" TextAlignment="Left"/>
                        <TextBlock Grid.Column="2" Text="Distribution" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushTextMuted}" TextAlignment="Left"/>
                        <TextBlock Grid.Column="3" Text="χ²" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushTextMuted}" TextAlignment="Right"/>
                        <TextBlock Grid.Column="4" Text="df" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushTextMuted}" TextAlignment="Right"/>
                        <TextBlock Grid.Column="5" Text="p" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushTextMuted}" TextAlignment="Right"/>
                        <TextBlock Grid.Column="6" Text="Decision" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushTextMuted}" TextAlignment="Left"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding ChiSquareRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChiSquareRow">
                                <Grid ColumnDefinitions="30,130,110,72,46,72,*" ColumnSpacing="8" Margin="0,2">
                                    <TextBlock Text="{Binding SerialNumber}"
                                               Foreground="{DynamicResource BrushTextMuted}"
                                               TextAlignment="Right"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Series}" TextAlignment="Left"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Distribution}" TextAlignment="Left"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Chi2}" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="4" Text="{Binding DegreesOfFreedom}" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="5" Text="{Binding PValue}" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="6" Text="{Binding Decision}" TextAlignment="Left"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Group heading: Simulation Verification (Phase 8D.1) — the
                 output-side model-verification widget below. -->
            <TextBlock Text="Simulation Verification"
                       FontSize="{DynamicResource FontSizeTitle}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushTextPrimary}"
                       Margin="0,24,0,8"/>

            <!-- Simulation verification widget (Phase 8B): output-side chi-square
                 over the samples the engine itself generated, confirming the run
                 matches the configured distribution (Banks / Law & Kelton model
                 verification). One chart card per series; empty until a run. -->
            <Border IsVisible="{Binding ShowSimulationVerification}"
                    Background="{DynamicResource BrushBackgroundPanel}"
                    BorderBrush="{DynamicResource BrushBorderDefault}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CornerRadiusM}"
                    Padding="{DynamicResource ThicknessSpaceM}">
                <StackPanel Spacing="{DynamicResource SpaceS}">
                    <TextBlock Text="Simulation verification"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextPrimary}"/>
                    <TextBlock Text="Chi-square goodness-of-fit of the engine's own generated samples against the configured distribution (output-side model verification)."
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource BrushTextSecondary}"/>
                    <TextBlock Text="{Binding SimulationVerification.EmptyMessage}"
                               IsVisible="{Binding SimulationVerification.IsEmpty}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource BrushTextMuted}"/>
                    <ItemsControl ItemsSource="{Binding SimulationVerification.Charts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:VerificationChartViewModel">
                                <controls:ChartCard Title="{Binding Title}"
                                                    Caption="{Binding Caption}"
                                                    EmptyStateText="No verification for this series."
                                                    ShowEmptyState="{Binding ShowEmptyState}"
                                                    ChartContent="{Binding ChartContent}"
                                                    Margin="0,0,0,16"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Group heading: Analytical Validation (Phase 8D.1) — the M/M/c
                 comparison widget below. -->
            <TextBlock Text="Analytical Validation"
                       FontSize="{DynamicResource FontSizeTitle}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushTextPrimary}"
                       Margin="0,24,0,8"/>

            <!-- Analytical validation widget (Phase 8C, FR-STAT-5): the
                 simulated per-stage wait and queue length against the closed-form
                 M/M/c (Erlang-C) values. Empty (with an explanation) when the
                 M/M/c assumptions do not hold. -->
            <Border IsVisible="{Binding ShowAnalyticalValidation}"
                    Background="{DynamicResource BrushBackgroundPanel}"
                    BorderBrush="{DynamicResource BrushBorderDefault}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CornerRadiusM}"
                    Padding="{DynamicResource ThicknessSpaceM}">
                <StackPanel Spacing="{DynamicResource SpaceS}">
                    <TextBlock Text="Analytical validation (M/M/c)"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextPrimary}"/>
                    <TextBlock Text="Simulated per-stage wait and queue length against the closed-form steady-state M/M/c (Erlang-C) values; valid only for exponential arrivals and service with ρ &lt; 1 over a long run."
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource BrushTextSecondary}"/>
                    <TextBlock Text="{Binding AnalyticalValidation.EmptyMessage}"
                               IsVisible="{Binding AnalyticalValidation.IsEmpty}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource BrushTextMuted}"/>
                    <StackPanel IsVisible="{Binding AnalyticalValidation.HasRows}"
                                Spacing="{DynamicResource SpaceS}">
                        <!-- Phase 8Q.5 (FR-UI-36): serial column added, all five
                             numeric columns right-aligned so the two sides of each
                             comparison share a decimal point. -->
                        <Grid ColumnDefinitions="30,120,95,95,90,90,60" ColumnSpacing="8">
                            <TextBlock Text="#" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushTextMuted}" TextAlignment="Right"/>
                            <TextBlock Grid.Column="1" Text="Stage" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushTextMuted}" TextAlignment="Left"/>
                            <TextBlock Grid.Column="2" Text="Sim wait" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushTextMuted}" TextAlignment="Right"/>
                            <TextBlock Grid.Column="3" Text="M/M/c wait" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushTextMuted}" TextAlignment="Right"/>
                            <TextBlock Grid.Column="4" Text="Sim queue" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushTextMuted}" TextAlignment="Right"/>
                            <TextBlock Grid.Column="5" Text="M/M/c queue" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushTextMuted}" TextAlignment="Right"/>
                            <TextBlock Grid.Column="6" Text="Δ%" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushTextMuted}" TextAlignment="Right"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding AnalyticalValidation.Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="services:ComparisonRow">
                                    <Grid ColumnDefinitions="30,120,95,95,90,90,60" ColumnSpacing="8" Margin="0,2">
                                        <TextBlock Text="{Binding SerialNumber}"
                                                   Foreground="{DynamicResource BrushTextMuted}"
                                                   TextAlignment="Right"/>
                                        <TextBlock Grid.Column="1" Text="{Binding StageName}" TextAlignment="Left"/>
                                        <TextBlock Grid.Column="2" Text="{Binding SimulatedAvgWait, StringFormat={}{0:0.###}}" TextAlignment="Right"/>
                                        <TextBlock Grid.Column="3" Text="{Binding AnalyticalAvgWait, StringFormat={}{0:0.###}}" TextAlignment="Right"/>
                                        <TextBlock Grid.Column="4" Text="{Binding SimulatedQueueLength, StringFormat={}{0:0.###}}" TextAlignment="Right"/>
                                        <TextBlock Grid.Column="5" Text="{Binding AnalyticalQueueLength, StringFormat={}{0:0.###}}" TextAlignment="Right"/>
                                        <TextBlock Grid.Column="6" Text="{Binding DeltaPercent, StringFormat={}{0:0.#}}" TextAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

        <!-- The bottom buffer (8Q.4, D-184). The last widget must be able to
                 travel clear of the panel's bottom edge, so the scrollable
                 content ends in a real element the extent accounts for. Height is
                 the SpaceXl token, so it restyles with the theme (§16.3).

                 NOT ScrollViewer.Padding: padding on a ScrollViewer sits OUTSIDE
                 the scroll extent, so it would shrink the viewport instead of
                 extending the content, and the last row would still be unable to
                 reach the top. That is the D-142 trap. -->
            <Border x:Name="ResultsBottomBuffer"
                    Height="{DynamicResource SpaceXl}"/>

        </StackPanel>
            </ScrollViewer>

            <!-- Row 2: the event trace (8Q.4, D-184, FR-UI-35). A SIBLING of the
                 ScrollViewer, never its child, for the same reason D-170 gave for
                 the calculations dialog's footer: a trace that scrolls away is not
                 a trace the user can read while reading anything else, and
                 scrolling the body can never take it out of reach. The ceiling is what
                 keeps it pinned without stealing the widgets' space — below it
                 the inner ScrollViewer scrolls.

                 Phase 8S (D-195): the ceiling was 240 px, and at a 420 px window
                 that starved the scrolling middle down to 101 px, which read to the
                 owner as the header and the trace overlapping the content. Measured:
                 the rows tiled exactly and never overlapped; the middle was simply
                 squeezed. The ceiling is now 200 px, still above the inner
                 ScrollViewer's own 176 px, so the box gives up only the heading
                 chrome it cannot scroll away and no more. The 120 px MinHeight
                 keeps the trace readable at its smallest.

                 Phase 8T.1: 208 -> 200. The run header gained a fourth line naming
                 the resolved operating sessions (FR-SIM-12), which pushed the three
                 rows to 426 px in a 420 px window, and Avalonia's Grid then shrank
                 the Auto header row by 3 px so the header and the scrolling middle
                 overlapped. The pinned trace box is the row that is meant to give up
                 space under pressure, so it gives up 8 px; the middle row keeps its
                 120 px floor. Phase 8T.5 deletes this row, and with it this ceiling. -->
            <Border Grid.Row="2"
                    Classes="results-trace-panel"
                    Margin="16,0"
                    Padding="{DynamicResource ThicknessSpaceM}"
                    Background="{DynamicResource BrushBackgroundPanel}"
                    BorderBrush="{DynamicResource BrushBorderDefault}"
                    BorderThickness="1,1,1,0"
                    CornerRadius="{DynamicResource CornerRadiusM}"
                    MinHeight="120"
                    MaxHeight="200">
                <Grid RowDefinitions="Auto,Auto,*">
                    <!-- One heading, and one caption. 8D.1 shipped a group heading
                         here and M4 shipped an inner label, so the trace carried
                         two labels saying the same thing (D-184). -->
                    <TextBlock Text="Event Trace"
                               FontSize="{DynamicResource FontSizeTitle}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextPrimary}"
                               Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="1"
                               Text="{x:Static vm:ResultsPanelViewModel.TracePanelCaption}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource BrushTextMuted}"
                               Margin="0,0,0,8"/>
                    <ScrollViewer Grid.Row="2"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  MaxHeight="176">
                        <SelectableTextBlock x:Name="TraceBodyText"
                                             Text="{Binding TraceBody}"
                                             FontFamily="{DynamicResource FontFamilyMono}"
                                             FontSize="{DynamicResource FontSizeCaption}"
                                             Foreground="{DynamicResource BrushTextPrimary}"
                                             TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>