<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:OpdSimulator.App.Controls"
             xmlns:vm="using:OpdSimulator.App.ViewModels"
             xmlns:views="using:OpdSimulator.App.Views"
             x:DataType="vm:ResultsPanelViewModel"
             x:Class="OpdSimulator.App.Views.ResultsPanel">

    <!-- Phase-5 results panel (Simulation tab, right column). Layout contract:
         welcome card until any run is attempted; afterwards the chosen widgets
         inside a scrollable stack. Widget order is stable: metrics →
         utilisation (6c.4) → chi-square → data preview → trace. -->
    <Grid>

        <!-- Welcome card (FR-UI-5). Content must be bound or the template
             never instantiates the card (5c welcome-card bug, part 3). -->
        <ContentControl IsVisible="{Binding IsWelcomeVisible}"
                        Content="{Binding Welcome}">
            <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:WelcomeCardViewModel">
                    <views:WelcomeCard/>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

        <!-- Results once a run starts. Header + widget picker stay pinned; the
             widgets themselves scroll (5c.1). -->
        <Grid IsVisible="{Binding HasRun}" RowDefinitions="Auto,*">
            <StackPanel Margin="16,16,16,0" Spacing="{DynamicResource SpaceM}">

            <!-- Run header + customise toggle. -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding RunSummary}"
                               FontSize="{DynamicResource FontSizeTitle}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextPrimary}"/>
                    <TextBlock Text="{Binding EffectiveExitText}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource BrushTextSecondary}"/>
                </StackPanel>
                <ToggleButton Grid.Column="1"
                              x:Name="CustomiseToggle"
                              Content="Customise results"
                              Margin="0,0,0,4"
                              VerticalAlignment="Top"
                              Click="OnCustomiseToggled"
                              ToolTip.Tip="Choose which result widgets are visible (FR-UI-14)"/>
            </Grid>

            <!-- Widget-visibility chooser. -->
            <Border x:Name="WidgetPicker"
                    IsVisible="False"
                    Background="{DynamicResource BrushBackgroundAlt}"
                    CornerRadius="{DynamicResource CornerRadiusM}"
                    Padding="{DynamicResource ThicknessSpaceM}">
                <StackPanel Spacing="{DynamicResource SpaceS}">
                    <TextBlock Text="Visible widgets"
                               FontSize="{DynamicResource FontSizeCaption}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextSecondary}"
                               ToolTip.Tip="Widget visibility is remembered; configuration and results are not (FR-UI-21)"/>
                    <UniformGrid Columns="2">
                        <CheckBox IsChecked="{Binding ShowMetrics, Mode=TwoWay}" Content="Metrics"/>
                        <CheckBox IsChecked="{Binding ShowChiSquare, Mode=TwoWay}" Content="Chi-square"/>
                        <CheckBox IsChecked="{Binding ShowTrace, Mode=TwoWay}" Content="Event trace"/>
                        <CheckBox IsChecked="{Binding ShowDataPreview, Mode=TwoWay}" Content="Data preview"/>
                        <CheckBox IsChecked="{Binding ShowUtilisation, Mode=TwoWay}" Content="Utilisation"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
            </StackPanel>

            <!-- Scrollable widget area (5c.1): metrics, utilisation, chi-square,
                 preview, trace scroll together; the selector row above stays pinned. -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="16" Spacing="{DynamicResource SpaceM}">

            <!-- Running progress. -->
            <StackPanel Spacing="4" IsVisible="{Binding IsBusy}">
                <ProgressBar IsIndeterminate="True"/>
                <TextBlock Text="{Binding StatusText}"
                           FontSize="{DynamicResource FontSizeCaption}"
                           Foreground="{DynamicResource BrushTextMuted}"/>
            </StackPanel>

            <!-- Run-refusal banner (G3/G4, 5-F): clean message, never a stack trace. -->
            <controls:ErrorBanner Message="{Binding RunError}"
                                  IsVisible="{Binding HasError}"
                                  ToolTip.Tip="The simulator did not run; read the message and adjust the configuration."/>

            <!-- Metrics widget (FR-STAT-6/7). -->
            <Border IsVisible="{Binding ShowMetrics}"
                    Background="{DynamicResource BrushBackgroundPanel}"
                    BorderBrush="{DynamicResource BrushBorderDefault}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CornerRadiusM}"
                    Padding="{DynamicResource ThicknessSpaceM}">
                <StackPanel Spacing="{DynamicResource SpaceM}">
                    <TextBlock Text="System totals"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextPrimary}"/>
                    <ItemsControl ItemsSource="{Binding SystemMetrics}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MetricRow">
                                <Grid ColumnDefinitions="170,*" ColumnSpacing="8" Margin="0,2">
                                    <TextBlock Text="{Binding Label}"
                                               FontSize="{DynamicResource FontSizeCaption}"
                                               Foreground="{DynamicResource BrushTextSecondary}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Value}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrushTextPrimary}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Per stage"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextPrimary}"/>
                    <Grid ColumnDefinitions="90,52,40,58,52,56,64,64,64" ColumnSpacing="8">
                        <TextBlock Text="Stage" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushTextMuted}"/>
                        <TextBlock Grid.Column="1" Text="λ" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushTextMuted}"/>
                        <TextBlock Grid.Column="2" Text="c" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushTextMuted}"/>
                        <TextBlock Grid.Column="3" Text="μ" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushTextMuted}"/>
                        <TextBlock Grid.Column="4" Text="ρ" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushTextMuted}"/>
                        <TextBlock Grid.Column="5" Text="Served" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushTextMuted}"/>
                        <TextBlock Grid.Column="6" Text="Wait (min)" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushTextMuted}"/>
                        <TextBlock Grid.Column="7" Text="Queue" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushTextMuted}"/>
                        <TextBlock Grid.Column="8" Text="Util." FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushTextMuted}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding StageRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:StageMetricRow">
                                <Grid ColumnDefinitions="90,52,40,58,52,56,64,64,64" ColumnSpacing="8" Margin="0,2">
                                    <TextBlock Text="{Binding StageName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ArrivalRate}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Servers}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding ServiceRate}"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Rho}"/>
                                    <TextBlock Grid.Column="5" Text="{Binding Served}"/>
                                    <TextBlock Grid.Column="6" Text="{Binding Wait}"/>
                                    <TextBlock Grid.Column="7" Text="{Binding Queue}"/>
                                    <TextBlock Grid.Column="8" Text="{Binding Utilisation}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Per-server utilisation widget (FR-STAT-7, Phase 6c.4): bar per
                 server, green or amber by imbalance; thin stage-average reference
                 line; empty state until a run finishes. -->
            <Border IsVisible="{Binding ShowUtilisation}"
                    Background="{DynamicResource BrushBackgroundPanel}"
                    BorderBrush="{DynamicResource BrushBorderDefault}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CornerRadiusM}"
                    Padding="{DynamicResource ThicknessSpaceM}">
                <StackPanel Spacing="{DynamicResource SpaceS}">
                    <TextBlock Text="Per-server utilisation"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextPrimary}"/>
                    <TextBlock Text="{Binding UtilisationCaption}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource BrushTextSecondary}"/>
                    <TextBlock Text="Run a simulation to see utilisation."
                               IsVisible="{Binding ShowUtilisationEmptyState}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource BrushTextMuted}"/>
                    <ContentControl IsVisible="{Binding HasUtilisationChart}"
                                    Content="{Binding UtilisationChart}"/>
                </StackPanel>
            </Border>

            <!-- Chi-square widget (FR-STAT-8). -->
            <Border IsVisible="{Binding ShowChiSquare}"
                    Background="{DynamicResource BrushBackgroundPanel}"
                    BorderBrush="{DynamicResource BrushBorderDefault}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CornerRadiusM}"
                    Padding="{DynamicResource ThicknessSpaceM}">
                <StackPanel Spacing="{DynamicResource SpaceS}">
<TextBlock Text="{Binding ChiSquareCaption}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushTextPrimary}"/>
                    <Grid ColumnDefinitions="130,110,72,46,72,*" ColumnSpacing="8">
                        <TextBlock Text="Series" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushTextMuted}"/>
                        <TextBlock Grid.Column="1" Text="Distribution" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushTextMuted}"/>
                        <TextBlock Grid.Column="2" Text="χ²" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushTextMuted}"/>
                        <TextBlock Grid.Column="3" Text="df" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushTextMuted}"/>
                        <TextBlock Grid.Column="4" Text="p" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushTextMuted}"/>
                        <TextBlock Grid.Column="5" Text="Decision" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushTextMuted}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding ChiSquareRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChiSquareRow">
                                <Grid ColumnDefinitions="130,110,72,46,72,*" ColumnSpacing="8" Margin="0,2">
                                    <TextBlock Text="{Binding Series}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Distribution}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Chi2}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding DegreesOfFreedom}"/>
                                    <TextBlock Grid.Column="4" Text="{Binding PValue}"/>
                                    <TextBlock Grid.Column="5" Text="{Binding Decision}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Data preview widget (FR-UI-20): only visible once a file was analysed. -->
            <Border IsVisible="{Binding ShowDataPreview}"
                    Background="{DynamicResource BrushBackgroundPanel}"
                    BorderBrush="{DynamicResource BrushBorderDefault}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CornerRadiusM}"
                    Padding="{DynamicResource ThicknessSpaceM}">
                <StackPanel Spacing="{DynamicResource SpaceS}">
                    <TextBlock Text="Uploaded data preview"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextPrimary}"/>
                    <controls:DataPreviewTable ColumnTitles="{Binding PreviewColumnTitles}"
                                               Rows="{Binding PreviewRows}"
                                               InvalidRows="{Binding PreviewInvalidRows}"
                                               LoadErrorSummary="{Binding PreviewError}"/>
                </StackPanel>
            </Border>

            <!-- Event trace widget: mono, scrollable, selectable text (M4). -->
            <Border IsVisible="{Binding ShowTrace}"
                    Background="{DynamicResource BrushBackgroundPanel}"
                    BorderBrush="{DynamicResource BrushBorderDefault}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CornerRadiusM}"
                    Padding="{DynamicResource ThicknessSpaceM}">
                <StackPanel Spacing="{DynamicResource SpaceS}">
                    <TextBlock Text="Event trace"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextPrimary}"/>
                    <ScrollViewer MaxHeight="360"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <SelectableTextBlock Text="{Binding TraceText}"
                                             FontFamily="{DynamicResource FontFamilyMono}"
                                             FontSize="{DynamicResource FontSizeCaption}"
                                             Foreground="{DynamicResource BrushTextPrimary}"
                                             TextWrapping="Wrap"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>

        </StackPanel>
        </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>