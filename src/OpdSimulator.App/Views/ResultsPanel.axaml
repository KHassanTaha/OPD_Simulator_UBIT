<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:OpdSimulator.App.Controls"
             xmlns:vm="using:OpdSimulator.App.ViewModels"
             xmlns:views="using:OpdSimulator.App.Views"
             x:DataType="vm:ResultsViewModel"
             x:Class="OpdSimulator.App.Views.ResultsPanel">

    <!-- Right panel (M5-E): the welcome card until a run starts; afterwards the
         chosen result widgets (FR-UI-14), each hidden via ShowX. -->
    <Grid>

        <!-- Welcome card (FR-UI-5). -->
        <ContentControl IsVisible="{Binding IsWelcomeVisible}"
                        Content="{Binding Welcome}">
            <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:WelcomeCardViewModel">
                    <views:WelcomeCard/>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

        <!-- Results content once a run starts. -->
        <StackPanel IsVisible="{Binding ShowResults}" Spacing="10" Margin="16">

            <!-- Run header + error banner + customise. -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding RunSummary}"
                               FontSize="{DynamicResource FontSizeBodyStrong}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextPrimary}"/>
                    <TextBlock Text="{Binding EffectivePExit, StringFormat='Effective exit probability (after Screening): {0}'}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource BrushTextSecondary}"/>
                </StackPanel>
                <ToggleButton Grid.Column="1"
                              x:Name="CustomiseToggle"
                              Content="Customise results"
                              Margin="0,0,0,4"
                              VerticalAlignment="Top"
                              Click="OnCustomiseToggled"
                              ToolTip.Tip="Choose which result widgets are visible (FR-UI-14)"/>
            </Grid>

            <!-- Widget visibility chooser. -->
            <Border x:Name="WidgetPicker"
                    IsVisible="False"
                    Background="{DynamicResource BrushBackgroundAlt}"
                    CornerRadius="{DynamicResource CornerRadiusMedium}"
                    Padding="{DynamicResource ThicknessSpaceM}">
                <UniformGrid Columns="3">
                    <CheckBox IsChecked="{Binding ShowMetrics, Mode=OneWay}" Click="OnWidgetToggle" Tag="metrics" Content="Metrics"/>
                    <CheckBox IsChecked="{Binding ShowChiSquare, Mode=OneWay}" Click="OnWidgetToggle" Tag="chiSquare" Content="Chi-square"/>
                    <CheckBox IsChecked="{Binding ShowTrace, Mode=OneWay}" Click="OnWidgetToggle" Tag="trace" Content="Trace"/>
                    <CheckBox IsChecked="{Binding ShowDataPreview, Mode=OneWay}" Click="OnWidgetToggle" Tag="dataPreview" Content="Data preview"/>
                    <CheckBox IsChecked="{Binding ShowCharts, Mode=OneWay}" Click="OnWidgetToggle" Tag="charts" Content="Charts"/>
                    <CheckBox IsChecked="{Binding ShowToken, Mode=OneWay}" Click="OnWidgetToggle" Tag="token" Content="Token"/>
                </UniformGrid>
            </Border>

            <!-- Running progress (M5-F). -->
            <StackPanel Spacing="4" IsVisible="{Binding IsRunning}">
                <ProgressBar IsIndeterminate="True"/>
                <TextBlock Text="{Binding StatusText}"
                           FontSize="{DynamicResource FontSizeCaption}"
                           Foreground="{DynamicResource BrushTextMuted}"/>
            </StackPanel>

            <!-- Run-refusal / error banner. -->
            <Border Background="{DynamicResource BrushErrorBackground}"
                    BorderBrush="{DynamicResource BrushError}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CornerRadiusSmall}"
                    Padding="{DynamicResource ThicknessSpaceM}"
                    IsVisible="{Binding HasError}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="&#xEA39;" Foreground="{DynamicResource BrushError}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding RunError}"
                               Foreground="{DynamicResource BrushErrorDark}"
                               TextWrapping="Wrap" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Metrics widget (FR-STAT-6/7). -->
            <Border x:Name="MetricsWidget"
                    IsVisible="{Binding ShowMetrics}"
                    Background="{DynamicResource BrushBackgroundPanel}"
                    BorderBrush="{DynamicResource BrushBorderDefault}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CornerRadiusMedium}"
                    Padding="{DynamicResource ThicknessSpaceM}">
                <StackPanel Spacing="10">
                    <TextBlock Text="System totals"
                               FontSize="{DynamicResource FontSizeHeading4}"
                               FontWeight="SemiBold"/>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Served" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushTextMuted}"/>
                            <TextBlock Text="{Binding System.Served}" FontSize="{DynamicResource FontSizeBodyStrong}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="Avg wait" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushTextMuted}"/>
                            <TextBlock Text="{Binding System.AvgWait}" FontSize="{DynamicResource FontSizeBodyStrong}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Text="Avg queue" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushTextMuted}"/>
                            <TextBlock Text="{Binding System.AvgQueue}" FontSize="{DynamicResource FontSizeBodyStrong}"/>
                        </StackPanel>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Stages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:StageResultsViewModel">
                                <Border BorderBrush="{DynamicResource BrushBorderDefault}" BorderThickness="0,1,0,0" Padding="0,6,0,6">
                                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*" ColumnSpacing="14">
                                        <TextBlock Text="{Binding StageName}" FontWeight="SemiBold" MinWidth="80"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ArrivalRate, StringFormat='λ={0}'}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding ServerCount, StringFormat='c={0}'}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding ServiceRate, StringFormat='μ={0}'}"/>
                                        <TextBlock Grid.Column="4" Text="{Binding Rho, StringFormat='ρ={0}'}"/>
                                        <TextBlock Grid.Column="5" Text="{Binding Served, StringFormat='served {0}'}"/>
                                        <TextBlock Grid.Column="6" Text="{Binding Wait, StringFormat='wait {0}m'}" ToolTip.Tip="Average waiting time in minutes"/>
                                        <TextBlock Grid.Column="7" Text="{Binding QueueLength, StringFormat='Lq {0}'}" ToolTip.Tip="Time-weighted average queue length"/>
                                        <TextBlock Grid.Column="8" Text="{Binding Utilisation, StringFormat='ρn {0}'}" ToolTip.Tip="Stage-level utilisation"/>
                                        <TextBlock Grid.Column="9" Text="{Binding PerServerUtilisation}" ToolTip.Tip="Utilisation per server"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- See ENGINE metrics export for details. -->
                    <TextBlock Text="Rho vs rho-note: ρ is traffic intensity; ρn is the mean server utilisation."
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource BrushTextMuted}"/>
                </StackPanel>
            </Border>

            <!-- Chi-square widget (FR-STAT-8). -->
            <Border x:Name="ChiSquareWidget"
                    IsVisible="{Binding ShowChiSquare}"
                    Background="{DynamicResource BrushBackgroundPanel}"
                    BorderBrush="{DynamicResource BrushBorderDefault}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CornerRadiusMedium}"
                    Padding="{DynamicResource ThicknessSpaceM}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Goodness-of-fit (χ², α = 0.05)"
                               FontSize="{DynamicResource FontSizeHeading4}"
                               FontWeight="SemiBold"/>
                    <ItemsControl ItemsSource="{Binding Fits}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:FitRowViewModel">
                                <StackPanel Spacing="2" Margin="0,4,0,4">
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold"
                                               FontSize="{DynamicResource FontSizeBodyStrong}"/>
                                    <TextBlock Text="{Binding Detail}"
                                               FontSize="{DynamicResource FontSizeBody}"
                                               Foreground="{DynamicResource BrushTextSecondary}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Verdict, StringFormat='Verdict: {0}'}"
                                               FontSize="{DynamicResource FontSizeCaption}"
                                               Foreground="{DynamicResource BrushTextMuted}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Charts widget (FR-UI-4). -->
            <Border IsVisible="{Binding ShowCharts}"
                    Background="{DynamicResource BrushBackgroundPanel}"
                    BorderBrush="{DynamicResource BrushBorderDefault}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CornerRadiusMedium}"
                    Padding="{DynamicResource ThicknessSpaceM}">
                <views:ChartsPanel DataContext="{Binding Charts}"/>
            </Border>

            <!-- Trace widget (M4 event log). -->
            <Border x:Name="TraceWidget"
                    IsVisible="{Binding ShowTrace}"
                    Background="{DynamicResource BrushBackgroundPanel}"
                    BorderBrush="{DynamicResource BrushBorderDefault}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CornerRadiusMedium}"
                    Padding="{DynamicResource ThicknessSpaceM}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Simulation trace"
                               FontSize="{DynamicResource FontSizeHeading4}"
                               FontWeight="SemiBold"/>
                    <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding TraceLines}" FontFamily="monospace">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- Data preview widget (FR-UI-20). -->
            <Border x:Name="PreviewWidget"
                    IsVisible="{Binding ShowDataPreview}"
                    Background="{DynamicResource BrushBackgroundPanel}"
                    BorderBrush="{DynamicResource BrushBorderDefault}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CornerRadiusMedium}"
                    Padding="{DynamicResource ThicknessSpaceM}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Data preview (read-only)"
                               FontSize="{DynamicResource FontSizeHeading4}"
                               FontWeight="SemiBold"/>
                    <controls:DataPreviewTable x:Name="ResultsPreviewTable"/>
                </StackPanel>
            </Border>

            <!-- Token widget (M6 placeholder readout; live estimates land in M6). -->
            <Border x:Name="TokenWidget"
                    IsVisible="{Binding ShowToken}"
                    Background="{DynamicResource BrushBackgroundPanel}"
                    BorderBrush="{DynamicResource BrushBorderDefault}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CornerRadiusMedium}"
                    Padding="{DynamicResource ThicknessSpaceM}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Tokens issued"
                               FontSize="{DynamicResource FontSizeHeading4}"
                               FontWeight="SemiBold"
                               ToolTip.Tip="Live per-patient token estimates arrive in the final milestone (M6)."/>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Patients assigned tokens" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushTextMuted}"/>
                            <TextBlock Text="{Binding System.Served}" FontSize="{DynamicResource FontSizeBodyStrong}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="Average waiting time" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushTextMuted}"/>
                            <TextBlock Text="{Binding System.AvgWait}" FontSize="{DynamicResource FontSizeBodyStrong}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>
</UserControl>