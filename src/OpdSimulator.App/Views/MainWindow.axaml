<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpdSimulator.App.Views.MainWindow"
        Title="OPD Clinic Queue Simulator"
        Width="1200"
        Height="760"
        MinWidth="1100"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource BrushBackgroundWindow}">

    <!-- Phase 1: empty application shell. Tabs land in Phase 3.
         The dynamic background proves theme resources resolve at startup. -->
</Window>