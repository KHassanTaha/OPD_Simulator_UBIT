<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:OpdSimulator.App.Controls"
             xmlns:views="using:OpdSimulator.App.Views"
             xmlns:viewModels="using:OpdSimulator.App.ViewModels"
             xmlns:vm="using:OpdSimulator.App.ViewModels"
             x:Class="OpdSimulator.App.Views.InputTab"
             x:DataType="viewModels:InputTabViewModel">

    <!-- Input tab (Phase 7D): one scrollable column that merges the old Data
         section (upload, preview, stage-mismatch warning) and the old Input
         Analysis tab (distribution-fit charts) (AGENTS §19.6). -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="{DynamicResource ThicknessWindowPadding}">

        <StackPanel Spacing="{DynamicResource SpaceM}">

            <!-- Upload / clear -->
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpaceS}">
                <Button Content="Upload Data"
                        Command="{Binding UploadFileCommand}"
                        Classes="PrimaryButton"
                        ToolTip.Tip="Opens a file picker for an .xlsx or .csv patient data file"/>
                <Button Content="Clear File"
                        Command="{Binding ClearFileCommand}"
                        Classes="GhostButton"
                        IsVisible="{Binding HasFile}"
                        ToolTip.Tip="Unload the data file and clear the preview and fit analysis"/>
                <TextBlock Text="{Binding StatusText}"
                           Classes="Caption"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource BrushTextMuted}"
                           Margin="8,0,0,0"/>
            </StackPanel>

            <!-- Validation banner (FR-UI-9): row issues or a load failure -->
            <controls:ErrorBanner Message="{Binding Preview.BannerMessage}"
                                  Severity="{Binding Preview.Severity}"
                                  IsVisible="{Binding Preview.HasValidationIssues}"
                                  ToolTip.Tip="The loaded file has validation problems; the affected rows are flagged in the preview below."/>

            <!-- Data preview (FR-UI-20) -->
            <Border IsVisible="{Binding HasFile}"
                    Classes="PanelCard"
                    Padding="{DynamicResource ThicknessSpaceM}">
                <StackPanel Spacing="{DynamicResource SpaceS}">
                    <TextBlock Text="Data preview"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextPrimary}"/>
                    <controls:DataPreviewTable ColumnTitles="{Binding Preview.ColumnTitles}"
                                               Rows="{Binding Preview.Rows}"
                                               InvalidRows="{Binding Preview.InvalidRows}"
                                               LoadErrorSummary="{Binding Preview.LoadErrorSummary}"
                                               MaxHeight="400"/>
                </StackPanel>
            </Border>

            <!-- Stage-count mismatch (D-114): full warning + actions live here
                 (Phase 7D); the Simulation tab shows only a one-line indicator. -->
            <Border IsVisible="{Binding HasStageMismatch}"
                    Background="{DynamicResource BrushWarningBackground}"
                    BorderBrush="{DynamicResource BrushWarning}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CornerRadiusM}"
                    Padding="{DynamicResource ThicknessSpaceS}">
                <StackPanel Spacing="{DynamicResource SpaceS}">
                    <TextBlock Text="{Binding StageMismatchMessage}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource BrushWarning}"
                               FontSize="{DynamicResource FontSizeCaption}"/>
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpaceXs}">
                        <Button Content="Sync stages from data"
                                Command="{Binding SyncStagesFromDataCommand}"
                                Classes="PrimaryButton"
                                ToolTip.Tip="Replace the configured stages with the stages found in the loaded data"/>
                        <Button Content="Keep current stages"
                                Command="{Binding KeepCurrentStagesCommand}"
                                Classes="GhostButton"
                                ToolTip.Tip="Keep the configured stages for this session; the warning is dismissed"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Action: hand the file to the Simulation tab -->
            <Button Content="Use for simulation →"
                    Command="{Binding UseForSimulationCommand}"
                    Classes="PrimaryButton"
                    HorizontalAlignment="Left"
                    IsVisible="{Binding HasFile}"
                    ToolTip.Tip="Go to the Simulation tab and fit the parameters from this file"/>

            <!-- Distribution-fit analysis for the loaded file -->
            <Border Height="1" Background="{DynamicResource BrushBorderDefault}"/>

            <!-- ── Servers present during data collection (Phase 8Q.1, D-178) ──
                 Sits directly below the upload row because it qualifies the file
                 that was just loaded: the counts are a property of the RECORDING,
                 not of the run, and historical utilisation cannot be computed
                 without them. -->
            <Border IsVisible="{Binding HasServerCounts}"
                    Classes="PanelCard"
                    Padding="{DynamicResource ThicknessSpaceM}">
                <StackPanel Spacing="{DynamicResource SpaceS}">
                    <TextBlock Text="Servers present during data collection"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextPrimary}"/>
                    <TextBlock Text="{Binding ServerCountCaption}"
                               Classes="Caption"
                               TextWrapping="Wrap"/>

                    <ItemsControl ItemsSource="{Binding ServerCounts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:HistoricalServerCountRow">
                                <controls:ValidatedField
                                    Margin="0,4,0,0"
                                    Label="{Binding StageName}"
                                    Watermark="1"
                                    Unit="servers"
                                    Value="{Binding Servers, Mode=TwoWay}"
                                    HasError="{Binding HasError}"
                                    ErrorMessage="{Binding ErrorMessage}"
                                    Tooltip="{Binding Tooltip}"
                                    HelpAnchor="historical-server-counts"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Historical utilisation: what the recorded counts imply about
                         the recorded data. The basis line names the divisor so the
                         figure is reproducible from what is on screen (D-176). -->
                    <StackPanel Spacing="{DynamicResource SpaceXs}"
                                Margin="0,8,0,0"
                                IsVisible="{Binding HistoricalMetrics.HasMetrics}">
                        <TextBlock Text="Historical utilisation"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                        <TextBlock Text="{Binding HistoricalMetrics.BasisText}"
                                   Classes="Caption"
                                   TextWrapping="Wrap"/>

                        <ItemsControl ItemsSource="{Binding HistoricalMetrics.Stages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:HistoricalStageRow">
                                    <Border Margin="0,4,0,0"
                                            Padding="{DynamicResource ThicknessSpaceS}"
                                            CornerRadius="4"
                                            Background="{DynamicResource BrushSurfaceSecondary}">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Headline}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock Classes="Caption" TextWrapping="Wrap">
                                                <Run Text="Total time in service:"/>
                                                <Run Text="{Binding BusyTimeText, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Classes="Caption" TextWrapping="Wrap">
                                                <Run Text="Operating time:"/>
                                                <Run Text="{Binding OperatingTimeText, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock TextWrapping="Wrap">
                                                <Run Text="Stage utilisation:"/>
                                                <Run Text="{Binding UtilisationText, Mode=OneWay}"
                                                     FontWeight="SemiBold"/>
                                                <Run Text="{Binding CalculationText, Mode=OneWay}"
                                                     Classes="Caption"/>
                                            </TextBlock>
                                            <!-- Above 100% is reported, never clamped:
                                                 it is evidence the recorded count is
                                                 too low (rulings 4). -->
                                            <controls:ErrorBanner
                                                Message="{Binding CapacityWarning}"
                                                Severity="Warning"
                                                IsVisible="{Binding HasCapacityWarning}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding HistoricalMetrics.PerServerNote}"
                                   Classes="Caption"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ── Observation window (D-172) ─────────────────────────────────
                 Sits above the fit charts because the window decides which
                 window λ is offered, and the λ choice is what the charts
                 describe. -->
            <StackPanel Spacing="{DynamicResource SpaceXs}" IsVisible="{Binding HasFile}">
                <TextBlock Text="Observation window"
                           FontSize="{DynamicResource FontSizeTitle}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushTextPrimary}"/>
                <TextBlock Text="How much OPERATING time this file covers. The clinic is shut overnight and at the weekend, so those hours are not counted."
                           Classes="Caption"
                           TextWrapping="Wrap"/>
                <ComboBox Name="WindowSelector"
                          ItemsSource="{Binding WindowOptions}"
                          SelectedItem="{Binding SelectedWindowLabel, Mode=TwoWay}"
                          HorizontalAlignment="Stretch"
                          ToolTip.Tip="The window the file's session dates imply. 'Auto' reads the file; the presets override it."/>
                <!-- FR-UI-17 via the shared ValidatedField: red 2px border, error
                     icon, cause + remedy text, and an accessible name that carries
                     the error to a screen reader. Built once, used here rather than
                     hand-rolled (§16.5: duplicating UI logic is a defect). -->
                <controls:ValidatedField
                    IsVisible="{Binding IsCustomWindowSelected}"
                    Label="Custom window (operating hours)"
                    Watermark="e.g. 5.5"
                    Unit="h"
                    Value="{Binding CustomHours, Mode=TwoWay}"
                    HasError="{Binding IsCustomWindowInvalid}"
                    ErrorMessage="{Binding CustomWindowErrorText}"
                    Tooltip="Operating hours the data covers. One clinic session is 2.75 hours, so 5.5 is two."
                    HelpAnchor="observation-window"/>
            </StackPanel>

            <!-- ── Two λ estimates (rulings 2, 4, 7) ────────────────────────
                 Both are always shown. Neither is presented as the correction
                 of the other, and the user picks which one drives the run. -->
            <Border IsVisible="{Binding HasFile}"
                    Background="{DynamicResource BrushSurfaceSecondary}"
                    CornerRadius="6"
                    Padding="{DynamicResource ThicknessSpaceS}">
                <StackPanel Spacing="{DynamicResource SpaceXs}">
                    <TextBlock Text="Arrival rate (λ)"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextPrimary}"/>
                    <TextBlock Text="{Binding MleLambdaText}"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding WindowLambdaText}"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding LambdaDivergenceText}"
                               Classes="Caption"
                               TextWrapping="Wrap"
                               IsVisible="{Binding !IsMleSelected}"/>

                    <TextBlock Text="Use for this run"
                               FontWeight="SemiBold"
                               Margin="0,8,0,0"
                               Foreground="{DynamicResource BrushTextPrimary}"/>
                    <RadioButton Content="MLE (1 ÷ mean inter-arrival gap)"
                                 GroupName="LambdaSource"
                                 IsChecked="{Binding IsMleSelected, Mode=TwoWay}"
                                 IsEnabled="{Binding HasMleLambda}"
                                 ToolTip.Tip="The rate while patients were arriving. Cross-session gaps are excluded."/>
                    <RadioButton Content="Window (arrivals ÷ operating minutes)"
                                 GroupName="LambdaSource"
                                 IsChecked="{Binding IsWindowSelected, Mode=TwoWay}"
                                 IsEnabled="{Binding !IsWindowChoiceDisabled}"
                                 ToolTip.Tip="The rate across the whole operating session, including the idle tail."/>
                </StackPanel>
            </Border>

            <StackPanel Spacing="{DynamicResource SpaceXs}" IsVisible="{Binding HasFile}">
                <TextBlock Text="Distribution fit"
                           FontSize="{DynamicResource FontSizeTitle}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushTextPrimary}"/>
                <TextBlock Text="Fit quality for the loaded data — histograms and chi-square goodness-of-fit."
                           Classes="Caption"/>
            </StackPanel>

            <Border IsVisible="{Binding HasFile}">
                <views:InputAnalysisView DataContext="{Binding Analysis}"/>
            </Border>

            <!-- Empty state -->
            <StackPanel IsVisible="{Binding !HasFile}"
                        Spacing="{DynamicResource SpaceS}"
                        MaxWidth="480"
                        HorizontalAlignment="Center"
                        Margin="0,48,0,0">
                <TextBlock Text="No data file loaded."
                           FontSize="{DynamicResource FontSizeTitle}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushTextPrimary}"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Upload a CSV or XLSX to fit distributions from historical data, or configure parameters manually in the Simulation tab."
                           Classes="Caption"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Phase 8S (D-198): the input tab had no trailing buffer at all, so the
                 last section sat flush against the window edge with no room to scroll
                 it clear. A real element inside the scrolling content — a taller
                 ScrollViewer.Padding would extend the viewport instead of the extent.
                 SpaceXl rather than SpaceL because nothing is pinned beneath this
                 scroller, so the buffer is the only breathing room the last section
                 gets. -->
            <Border Classes="scroll-buffer"
                    Height="{DynamicResource SpaceXl}"
                    Background="Transparent"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
