<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="using:OpdSimulator.App.ViewModels"
             x:Class="OpdSimulator.App.Views.InputAnalysisView"
             x:DataType="viewModels:InputAnalysisViewModel">

    <Panel>
        <!-- Chart stack: populated from 6c.2 onward, one ChartCard per chart.
             Only visible once a data file is loaded (HasData). -->
        <ScrollViewer IsVisible="{Binding HasData}">
            <StackPanel Spacing="{DynamicResource SpaceM}">
            </StackPanel>
        </ScrollViewer>

        <!-- Empty state: the tab's launch and reset appearance. -->
        <StackPanel IsVisible="{Binding IsEmpty}"
                    Spacing="{DynamicResource SpaceS}"
                    MaxWidth="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <TextBlock Text="Input analysis"
                       FontSize="{DynamicResource FontSizeTitle}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushTextPrimary}"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding EmptyMessage}"
                       Classes="Caption"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Panel>
</UserControl>