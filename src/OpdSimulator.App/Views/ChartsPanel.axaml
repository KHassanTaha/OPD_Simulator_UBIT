<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Avalonia;assembly=LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:vm="using:OpdSimulator.App.ViewModels"
             x:DataType="vm:ChartsPanelViewModel"
             x:Class="OpdSimulator.App.Views.ChartsPanel">

    <!-- Charts widget (FR-UI-4): input analysis + simulation run tabs rendered
         with LiveCharts2 (decision D-057). -->
    <Grid>

        <!-- Empty state until the first run. -->
        <StackPanel IsVisible="{Binding ShowEmpty}"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6"
                    MaxWidth="320">
            <TextBlock Text="Charts appear after a run."
                       Foreground="{DynamicResource BrushTextMuted}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Input analysis charts also need a data file; without live data the engine models arrival and service times directly."
                       FontSize="{DynamicResource FontSizeCaption}"
                       Foreground="{DynamicResource BrushTextMuted}"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <TabControl IsVisible="{Binding HasCharts}">

            <!-- Input analysis tab. -->
            <TabItem Header="Input analysis">
                <ItemsControl ItemsSource="{Binding InputCharts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChartViewModel">
                            <StackPanel Spacing="4" Margin="0,0,0,14">
                                <StackPanel IsVisible="{Binding HasData, Mode=OneTime}">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                               FontSize="{DynamicResource FontSizeBodyStrong}"/>
                                    <lvc:CartesianChart Series="{Binding Series}"
                                                        XAxes="{Binding XAxes}"
                                                        YAxes="{Binding YAxes}"
                                                        Height="200"/>
                                </StackPanel>
                                <TextBlock Text="No data for this analysis."
                                           Foreground="{DynamicResource BrushTextMuted}"
                                           IsVisible="{Binding ShowEmpty, Mode=OneTime}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </TabItem>

            <!-- Simulation run tab. -->
            <TabItem Header="Simulation run">
                <ItemsControl ItemsSource="{Binding RunCharts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChartViewModel">
                            <StackPanel Spacing="4" Margin="0,0,0,14">
                                <StackPanel IsVisible="{Binding HasData, Mode=OneTime}">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                               FontSize="{DynamicResource FontSizeBodyStrong}"/>
                                    <lvc:CartesianChart Series="{Binding Series}"
                                                        XAxes="{Binding XAxes}"
                                                        YAxes="{Binding YAxes}"
                                                        Height="200"/>
                                </StackPanel>
                                <TextBlock Text="No data for this series."
                                           Foreground="{DynamicResource BrushTextMuted}"
                                           IsVisible="{Binding ShowEmpty, Mode=OneTime}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>