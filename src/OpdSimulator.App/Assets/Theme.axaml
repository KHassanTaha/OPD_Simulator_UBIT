<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System">

    <!--
        THEME.AXAML — the single definition of every colour, brush, font,
        spacing, radius, shadow and focus-ring token used anywhere in the app
        (AGENTS §16.3). Views reference these via {DynamicResource } only;
        hex values appear ONLY in this file. Motion durations live in
        Motion.axaml, not here.

        Token contract (Phase 1):
          - fonts:      FontFamilyDefault (UI), FontFamilyHeading, FontFamilyMono
          - font sizes: 18 (title), 14 (body), 12 (caption)
          - spacing:    4, 8, 12, 16, 24
          - radii:      4 (S), 8 (M), 12 (L)
          - shadows:    ShadowCard, ShadowOverlay
          - focus ring: BrushFocusRing + ThicknessFocusRing(2) + ThicknessFocusRingOffset(1)
    -->

    <!-- ============ Palette (Colours) ============ -->
    <Color x:Key="ColorBrandGreen">#1B7A4C</Color>
    <Color x:Key="ColorBrandGreenDark">#145C39</Color>
    <Color x:Key="ColorBrandGreenLight">#2E9E62</Color>
    <Color x:Key="ColorAccentInfo">#0B7285</Color>
    <Color x:Key="ColorFocusRing">#1565C0</Color>

    <Color x:Key="ColorBackgroundWindow">#F4F6F5</Color>
    <Color x:Key="ColorBackgroundPanel">#FFFFFF</Color>
    <Color x:Key="ColorBackgroundAlt">#E9EDEA</Color>
    <Color x:Key="ColorBackgroundHover">#E2E8E4</Color>

    <Color x:Key="ColorTextPrimary">#1A2320</Color>
    <Color x:Key="ColorTextSecondary">#44504A</Color>
    <Color x:Key="ColorTextMuted">#6B766F</Color>
    <Color x:Key="ColorTextOnBrand">#FFFFFF</Color>

    <Color x:Key="ColorBorderDefault">#C9D1CC</Color>
    <Color x:Key="ColorBorderHover">#A4B3A9</Color>
    <Color x:Key="ColorBorderFocused">#1B7A4C</Color>

    <Color x:Key="ColorError">#B3261E</Color>
    <Color x:Key="ColorErrorDark">#7A1712</Color>
    <Color x:Key="ColorErrorBackground">#FCEAE8</Color>
    <Color x:Key="ColorWarning">#8A5300</Color>
    <Color x:Key="ColorWarningBackground">#FFF4E0</Color>
    <Color x:Key="ColorSuccess">#145C39</Color>
    <Color x:Key="ColorSuccessBackground">#E6F4EB</Color>

    <Color x:Key="ColorDisabledBackground">#EDF0EE</Color>
    <Color x:Key="ColorDisabledText">#9AA39D</Color>
    <Color x:Key="ColorOverlayDim">#66000000</Color>
    <Color x:Key="ColorSelection">#C8E6D3</Color>

    <!-- ============ Brushes ============ -->
    <SolidColorBrush x:Key="BrushBrandGreen" Color="{StaticResource ColorBrandGreen}"/>
    <SolidColorBrush x:Key="BrushBrandGreenDark" Color="{StaticResource ColorBrandGreenDark}"/>
    <SolidColorBrush x:Key="BrushBrandGreenLight" Color="{StaticResource ColorBrandGreenLight}"/>
    <SolidColorBrush x:Key="BrushAccentInfo" Color="{StaticResource ColorAccentInfo}"/>
    <SolidColorBrush x:Key="BrushFocusRing" Color="{StaticResource ColorFocusRing}"/>

    <SolidColorBrush x:Key="BrushBackgroundWindow" Color="{StaticResource ColorBackgroundWindow}"/>
    <SolidColorBrush x:Key="BrushBackgroundPanel" Color="{StaticResource ColorBackgroundPanel}"/>
    <SolidColorBrush x:Key="BrushBackgroundAlt" Color="{StaticResource ColorBackgroundAlt}"/>
    <SolidColorBrush x:Key="BrushBackgroundHover" Color="{StaticResource ColorBackgroundHover}"/>

    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}"/>
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}"/>
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}"/>
    <SolidColorBrush x:Key="BrushTextOnBrand" Color="{StaticResource ColorTextOnBrand}"/>

    <SolidColorBrush x:Key="BrushBorderDefault" Color="{StaticResource ColorBorderDefault}"/>
    <SolidColorBrush x:Key="BrushBorderHover" Color="{StaticResource ColorBorderHover}"/>
    <SolidColorBrush x:Key="BrushBorderFocused" Color="{StaticResource ColorBorderFocused}"/>

    <SolidColorBrush x:Key="BrushError" Color="{StaticResource ColorError}"/>
    <SolidColorBrush x:Key="BrushErrorDark" Color="{StaticResource ColorErrorDark}"/>
    <SolidColorBrush x:Key="BrushErrorBackground" Color="{StaticResource ColorErrorBackground}"/>
    <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ColorWarning}"/>
    <SolidColorBrush x:Key="BrushWarningBackground" Color="{StaticResource ColorWarningBackground}"/>
    <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource ColorSuccess}"/>
    <SolidColorBrush x:Key="BrushSuccessBackground" Color="{StaticResource ColorSuccessBackground}"/>

    <SolidColorBrush x:Key="BrushDisabledBackground" Color="{StaticResource ColorDisabledBackground}"/>
    <SolidColorBrush x:Key="BrushDisabledText" Color="{StaticResource ColorDisabledText}"/>
    <SolidColorBrush x:Key="BrushOverlayDim" Color="{StaticResource ColorOverlayDim}"/>
    <SolidColorBrush x:Key="BrushSelection" Color="{StaticResource ColorSelection}"/>

    <!-- ============ Typography (3 families max) ============ -->
    <FontFamily x:Key="FontFamilyDefault">Inter, Segoe UI, Ubuntu, Noto Sans, sans-serif</FontFamily>
    <FontFamily x:Key="FontFamilyHeading">Inter, Segoe UI, Ubuntu, Noto Sans, sans-serif</FontFamily>
    <FontFamily x:Key="FontFamilyMono">JetBrains Mono, Cascadia Mono, Consolas, monospace</FontFamily>

    <!-- Font sizes: 18 title / 14 body / 12 caption. -->
    <sys:Double x:Key="FontSizeCaption">12</sys:Double>
    <sys:Double x:Key="FontSizeBody">14</sys:Double>
    <sys:Double x:Key="FontSizeTitle">18</sys:Double>

    <!-- ============ Spacing (4, 8, 12, 16, 24) ============ -->
    <sys:Double x:Key="SpaceXxs">4</sys:Double>
    <sys:Double x:Key="SpaceXs">8</sys:Double>
    <sys:Double x:Key="SpaceS">12</sys:Double>
    <sys:Double x:Key="SpaceM">16</sys:Double>
    <sys:Double x:Key="SpaceL">24</sys:Double>

    <Thickness x:Key="ThicknessSpaceXxs">4</Thickness>
    <Thickness x:Key="ThicknessSpaceXs">8</Thickness>
    <Thickness x:Key="ThicknessSpaceS">12</Thickness>
    <Thickness x:Key="ThicknessSpaceM">16</Thickness>
    <Thickness x:Key="ThicknessSpaceL">24</Thickness>

    <Thickness x:Key="ThicknessWindowPadding">16</Thickness>
    <Thickness x:Key="ThicknessControlPadding">10,6</Thickness>
    <Thickness x:Key="ThicknessFieldPadding">10,8</Thickness>
    <Thickness x:Key="ThicknessSectionHeader">12,10</Thickness>
    <Thickness x:Key="ThicknessFieldBorder">1</Thickness>
    <Thickness x:Key="ThicknessCardPadding">16</Thickness>

    <!-- ============ Radii (4, 8, 12) ============ -->
    <CornerRadius x:Key="CornerRadiusS">4</CornerRadius>
    <CornerRadius x:Key="CornerRadiusM">8</CornerRadius>
    <CornerRadius x:Key="CornerRadiusL">12</CornerRadius>

    <!-- ============ Shadows ============ -->
    <BoxShadows x:Key="ShadowCard">0 1 3 0 #1F000000</BoxShadows>
    <BoxShadows x:Key="ShadowOverlay">0 8 24 0 #33000000</BoxShadows>

    <!-- ============ Focus ring ============ -->
    <Thickness x:Key="ThicknessFocusRing">2</Thickness>
    <Thickness x:Key="ThicknessFocusRingOffset">1</Thickness>

</ResourceDictionary>