<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:OpdSimulator.App.Controls">

    <!-- Control themes for the chrome-style controls. Kept here so every
         control inherits theme resources (AGENTS §16.3) and no view re-declares
         the same template. -->

    <!-- CollapsibleSection: header ToggleButton (Enter/Space toggles by default)
         + body ContentPresenter wired to the templated CollapsibleSection. -->
    <ControlTheme x:Key="{x:Type controls:CollapsibleSection}"
                  TargetType="controls:CollapsibleSection">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{DynamicResource BrushBackgroundPanel}"
                        BorderBrush="{DynamicResource BrushBorderDefault}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource CornerRadiusMedium}">
                    <StackPanel>
                        <ToggleButton x:Name="PART_HeaderButton"
                                      Classes="collapsibleHeader"
                                      IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock x:Name="PART_Chevron" Text="&#xE70D;" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{TemplateBinding Header}"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"/>
                            </Grid>
                        </ToggleButton>
                        <ContentPresenter x:Name="PART_BodyPresenter"
                                          Margin="14,4,14,14"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Content="{TemplateBinding Content}"/>
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- PinnedFooterBar: bottom chrome with a content slot. -->
    <ControlTheme x:Key="{x:Type controls:PinnedFooterBar}"
                  TargetType="controls:PinnedFooterBar">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{DynamicResource BrushBackgroundPanel}"
                        BorderBrush="{DynamicResource BrushBorderDefault}"
                        BorderThickness="0,1,0,0"
                        Padding="{DynamicResource ThicknessSpaceM}">
                    <ContentPresenter ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Content="{TemplateBinding Content}"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>