<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpdSimulator.App.Controls.ThemedDialog"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource BrushBackgroundWindow}">

    <!-- ThemedDialog — AGENTS §16.2 "Themed dialog | all confirmations and
         errors | never OS-native". Modal focus trap is native; Escape returns
         Cancel; closing returns focus to the owner.
         Phase 8E / Bug 4: the outer padding was 0 and both vertical gaps were a
         single uniform 16, which read as cramped next to the rest of the UI.
         Now 24 outer padding, 16 between title and message, 24 between message
         and the button row, 12 between the buttons — all theme tokens.
         The two different gaps come from two nested StackPanels: Avalonia
         cannot parse a Thickness that mixes a literal with a DynamicResource
         (AVLN2005), so the gaps are expressed as Spacing instead. -->
    <Border CornerRadius="{DynamicResource CornerRadiusL}"
            Padding="{DynamicResource ThicknessSpaceL}">
        <StackPanel Spacing="{DynamicResource SpaceM}">

            <TextBlock x:Name="DialogTitle"
                       Text="{Binding $parent[Window].Title}"
                       FontSize="{DynamicResource FontSizeTitle}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushTextPrimary}"/>

            <StackPanel Spacing="{DynamicResource SpaceL}">

                <ScrollViewer MaxHeight="420"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="DialogMessage"
                               TextWrapping="Wrap"
                               FontSize="{DynamicResource FontSizeBody}"
                               Foreground="{DynamicResource BrushTextSecondary}"
                               LineHeight="20"/>
                </ScrollViewer>

                <!-- Phase 8M (D-164, FR-UI-29): optional rich body for dialogs that
                     need more than a paragraph — the calculations dialog supplies
                     sections, monospace figures and its own copy button through
                     Body. Hidden for the message-only callers (ShowMessageAsync),
                     so the confirm/error dialogs on this control are unchanged. -->
                <!-- Visibility is set in code-behind by the Body setter; the
                     ancestor-type binding cannot resolve inside the control's
                     own XAML, and a self-contained dialog is simpler with an
                     explicit IsVisible than with a name lookup. -->
                <ContentControl x:Name="DialogBodyHost" IsVisible="False"/>

                <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                      ColumnSpacing="{DynamicResource SpaceS}">
                    <!-- Copy-to-clipboard, shown only when CopyText is set. The
                         calculations dialog is long enough that a reader will
                         want to paste it into their own notes (D-164). -->
                    <Button Grid.Column="1"
                            x:Name="CopyButton"
                            Classes="GhostButton"
                            Click="OnCopyClick"
                            Content="Copy"
                            MinWidth="88"
                            HorizontalAlignment="Right"
                            IsVisible="False"/>
                    <Button Grid.Column="2"
                            x:Name="SecondaryButton"
                            Classes="GhostButton"
                            Click="OnSecondaryClick"
                            MinWidth="88"
                            HorizontalAlignment="Right"/>
                    <Button Grid.Column="3"
                            x:Name="PrimaryButton"
                            Classes="PrimaryButton"
                            Click="OnPrimaryClick"
                            MinWidth="88"
                            HorizontalAlignment="Right"
                            IsDefault="True"/>
                </Grid>

            </StackPanel>

        </StackPanel>
    </Border>
</Window>