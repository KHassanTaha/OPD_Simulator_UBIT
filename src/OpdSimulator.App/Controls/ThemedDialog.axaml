<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpdSimulator.App.Controls.ThemedDialog"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource BrushBackgroundWindow}">

    <!-- ThemedDialog — AGENTS §16.2 "Themed dialog | all confirmations and
         errors | never OS-native". Modal focus trap is native; Escape returns
         Cancel; closing returns focus to the owner.
         Phase 8E / Bug 4: the outer padding was 0 and both vertical gaps were a
         single uniform 16, which read as cramped next to the rest of the UI.
         Now 24 outer padding, 16 between title and message, 24 between message
         and the button row, 12 between the buttons — all theme tokens.
         The two different gaps come from two nested StackPanels: Avalonia
         cannot parse a Thickness that mixes a literal with a DynamicResource
         (AVLN2005), so the gaps are expressed as Spacing instead. -->
    <Border CornerRadius="{DynamicResource CornerRadiusL}"
            Padding="{DynamicResource ThicknessSpaceL}">
        <StackPanel Spacing="{DynamicResource SpaceM}">

            <TextBlock x:Name="DialogTitle"
                       Text="{Binding $parent[Window].Title}"
                       FontSize="{DynamicResource FontSizeTitle}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushTextPrimary}"/>

            <StackPanel Spacing="{DynamicResource SpaceL}">

                <ScrollViewer MaxHeight="420"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="DialogMessage"
                               TextWrapping="Wrap"
                               FontSize="{DynamicResource FontSizeBody}"
                               Foreground="{DynamicResource BrushTextSecondary}"
                               LineHeight="20"/>
                </ScrollViewer>

                <Grid ColumnDefinitions="*,Auto,Auto"
                      ColumnSpacing="{DynamicResource SpaceS}">
                    <Button Grid.Column="1"
                            x:Name="SecondaryButton"
                            Classes="GhostButton"
                            Click="OnSecondaryClick"
                            MinWidth="88"
                            HorizontalAlignment="Right"/>
                    <Button Grid.Column="2"
                            x:Name="PrimaryButton"
                            Classes="PrimaryButton"
                            Click="OnPrimaryClick"
                            MinWidth="88"
                            HorizontalAlignment="Right"
                            IsDefault="True"/>
                </Grid>

            </StackPanel>

        </StackPanel>
    </Border>
</Window>