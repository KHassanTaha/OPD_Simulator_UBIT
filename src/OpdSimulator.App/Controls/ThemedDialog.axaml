<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpdSimulator.App.Controls.ThemedDialog"
        Width="520"
        MinWidth="440"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBackgroundWindow}"
        InputElement.IsTabStop="True">

    <Border Background="{DynamicResource BrushBackgroundPanel}"
            CornerRadius="{DynamicResource CornerRadiusMedium}"
            Margin="24"
            Padding="{DynamicResource ThicknessSpaceL}">
        <StackPanel Spacing="12">
            <Grid ColumnDefinitions="Auto,*">
                <Border x:Name="IconBadge"
                        Width="34"
                        Height="34"
                        CornerRadius="17"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top">
                    <TextBlock x:Name="Glyph" FontWeight="SemiBold"
                               FontSize="{DynamicResource FontSizeBodyStrong}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="TitleText"
                           Grid.Column="1"
                           Margin="12,0,0,0"
                           FontSize="{DynamicResource FontSizeHeading3}"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"/>
            </Grid>

            <TextBlock x:Name="MessageText"
                       TextWrapping="Wrap"
                       FontSize="{DynamicResource FontSizeBody}"
                       Foreground="{DynamicResource BrushTextSecondary}"/>

            <TextBox x:Name="InputTextBox"
                     IsVisible="False"
                     Watermark="Enter a value…"
                     FontSize="{DynamicResource FontSizeBody}"/>

            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,16,0,0">
                <Button Grid.Column="1" x:Name="CancelButton" Classes="dialogButton"
                        Margin="0,0,12,0" Click="OnCancelClicked"/>
                <Button Grid.Column="2" x:Name="ConfirmButton" Classes="primaryDialogButton"
                        Click="OnConfirmClicked"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>