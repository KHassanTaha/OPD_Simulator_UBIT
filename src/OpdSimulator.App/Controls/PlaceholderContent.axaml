<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:OpdSimulator.App.Controls"
             x:Class="OpdSimulator.App.Controls.PlaceholderContent">

    <!-- PlaceholderContent — interim shell filler so every tab renders a
         theme-resourced, centred "coming in Phase N" card until the real
         panels replace it (ConfigPanel Phase 4, ResultsPanel Phase 5,
         Help Phase 6). Reusable across all four tabs (§16.5). -->
    <Border Classes="PanelCard">
        <StackPanel Spacing="{DynamicResource SpaceS}"
                    MaxWidth="520"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <TextBlock Text="{Binding $parent[controls:PlaceholderContent].Title}"
                       FontSize="{DynamicResource FontSizeTitle}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushTextPrimary}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"/>
            <TextBlock Text="{Binding $parent[controls:PlaceholderContent].Hint}"
                       Classes="Caption"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Border>
</UserControl>