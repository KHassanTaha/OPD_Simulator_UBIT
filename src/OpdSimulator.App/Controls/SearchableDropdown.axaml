<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:OpdSimulator.App.Controls"
             x:Class="OpdSimulator.App.Controls.SearchableDropdown"
             x:DataType="controls:SearchableDropdown">

    <!-- SearchableDropdown — FR-UI-6 / AGENTS §16.2 "Searchable dropdown":
         type-to-filter, × clear, keyboard navigation (Up/Down/Enter/Escape),
         tab-reachable focus anchor. The item list lives in a Popup and is
         driven from code-behind so behaviour stays deterministic. -->
    <StackPanel Spacing="{DynamicResource SpaceXxs}">

        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0"
                       Text="{Binding $parent[controls:SearchableDropdown].Label}"
                       FontSize="{DynamicResource FontSizeBody}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushTextPrimary}"
                       VerticalAlignment="Center"/>
            <controls:InfoIcon Grid.Column="1"
                      Margin="6,0,0,0"
                      HelpText="{Binding $parent[controls:SearchableDropdown].Tooltip}"
                      HelpAnchor="{Binding $parent[controls:SearchableDropdown].HelpAnchor}"/>
        </Grid>

        <Border x:Name="ComboHost"
                BorderBrush="{DynamicResource BrushBorderDefault}"
                BorderThickness="1"
                CornerRadius="{DynamicResource CornerRadiusS}"
                Background="{DynamicResource BrushBackgroundPanel}">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBox x:Name="FilterBox"
                         Grid.Column="0"
                         Background="Transparent"
                         CornerRadius="0"
                         Padding="{DynamicResource ThicknessFieldPadding}"
                         Watermark="{Binding $parent[controls:SearchableDropdown].Placeholder}"
                         GotFocus="OnFilterGotFocus"
                         LostFocus="OnFilterLostFocus"
                         TextChanged="OnFilterTextChanged"
                         KeyDown="OnFilterKeyDown">
                    <!-- Phase 8E / Bug 2: Avalonia's Fluent theme paints a blue
                         focus ring on TextBox. Replace the accent with the brand
                         green from the theme; the ring stays VISIBLE (keyboard
                         pass, AGENTS §16.7) — only its colour changes. Overridden
                         here, in the control's own style block, not in Theme.axaml,
                         so no other TextBox in the app is affected.
                         The unfocused "no border" is a plain TextBox setter rather
                         than a local BorderThickness="0": a local value outranks
                         every style setter, so it would have silently beaten the
                         :focus rule and left the ring invisible. -->
                    <TextBox.Styles>
                        <Style Selector="TextBox">
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                        <Style Selector="TextBox:focus">
                            <Setter Property="BorderBrush" Value="{DynamicResource BrushBrandGreen}"/>
                            <Setter Property="BorderThickness" Value="{DynamicResource ThicknessFieldBorder}"/>
                        </Style>
                        <Style Selector="TextBox:focus-visible">
                            <Setter Property="BorderBrush" Value="{DynamicResource BrushBrandGreen}"/>
                            <Setter Property="BorderThickness" Value="{DynamicResource ThicknessFieldBorder}"/>
                        </Style>
                    </TextBox.Styles>
                </TextBox>
                <Border x:Name="ClearButton"
                        Grid.Column="1"
                        IsVisible="False"
                        Background="Transparent"
                        CornerRadius="{DynamicResource CornerRadiusS}"
                        Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        PointerPressed="OnClearClick"
                        ToolTip.Tip="Clear the selection">
                    <TextBlock Text="&#x2715;"
                               Foreground="{DynamicResource BrushTextMuted}"
                               VerticalAlignment="Center"
                               Margin="6,4"/>
                </Border>
                <Path Grid.Column="2"
                      Data="M 2 6 L 8 0 L 14 6"
                      Stroke="{DynamicResource BrushTextMuted}"
                      StrokeThickness="2"
                      StrokeLineCap="Round"
                      VerticalAlignment="Center"
                      Margin="0,0,10,0"/>
            </Grid>
        </Border>

        <Popup x:Name="DropdownPopup"
               Placement="BottomEdgeAlignedLeft"
               IsLightDismissEnabled="False">
            <!-- Phase 8E / Bug 3: light dismiss is switched OFF on purpose.
                 The × clear button sits outside the popup, so a light-dismiss
                 click tore the list down in the middle of the clear handler:
                 the committed value was restored from the tearing-down list and
                 the popup was left closed, so "clear, then pick" could not be
                 completed. Outside clicks are still handled — losing focus
                 closes the popup, through OnFilterLostFocus / OnListLostFocus —
                 and Escape / selection / filter blur behave as before. This
                 only stops the teardown from racing the clear. -->
            <Border Background="{DynamicResource BrushBackgroundPanel}"
                    BorderBrush="{DynamicResource BrushBorderDefault}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CornerRadiusM}"
                    BoxShadow="{DynamicResource ShadowOverlay}"
                    Padding="{DynamicResource ThicknessSpaceXxs}"
                    MinWidth="240"
                    MaxHeight="280">
                <ListBox x:Name="ItemList"
                         Background="Transparent"
                         BorderThickness="0"
                         KeyboardNavigation.TabNavigation="Cycle"
                         SelectionChanged="OnListSelectionChanged"
                         GotFocus="OnListGotFocus"
                         LostFocus="OnListLostFocus"
                         KeyDown="OnListKeyDown"/>
            </Border>
        </Popup>

    </StackPanel>
</UserControl>