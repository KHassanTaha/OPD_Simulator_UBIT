<TemplatedControl xmlns="https://github.com/avaloniaui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:controls="using:OpdSimulator.App.Controls"
                  x:Class="OpdSimulator.App.Controls.CollapsibleSection"
                  x:DataType="controls:CollapsibleSection">

    <TemplatedControl.Resources>

        <!-- HeaderToggleSwitch (4c.2): the Fluent ToggleSwitch only exposes
             KnobTransitions/OnContent/OffContent, not knob colours, so its
             default dark knob is lost against the brand-green header. This
             local theme draws an explicit white/light track + knob that reads
             on the blue bar: dark-on-white when OFF, white-on-dark when ON.
             ToggleSwitch requires PART_MovingKnobs to be a Panel (its knob
             animation target), so the knob is a Panel wrapping a Border.
             State styles (checked/focus colours and knob slide) are inline
             children of the theme with x:SetterTargetType so the compiled
             setters know each part's CLR type (Fluent uses VisualStateManager
             for the same job; inline Styles on parts need this directive in
             compiled XAML). -->
        <ControlTheme x:Key="HeaderToggleSwitch"
                      TargetType="ToggleSwitch">
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="PART_Track"
                            Background="{DynamicResource BrushBackgroundPanel}"
                            BorderBrush="{DynamicResource BrushTextOnBrand}"
                            BorderThickness="1"
                            CornerRadius="11"
                            Width="40"
                            Height="22"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Panel x:Name="PART_MovingKnobs"
                               Margin="2"
                               HorizontalAlignment="Left">
                            <Border x:Name="PART_KnobVisual"
                                    Width="16"
                                    Height="16"
                                    VerticalAlignment="Center"
                                    CornerRadius="8"
                                    Background="{DynamicResource BrushBrandGreenDark}"/>
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:checked /template/ #PART_Track" x:SetterTargetType="Border">
                <Setter Property="Background" Value="{DynamicResource BrushBrandGreenDark}"/>
            </Style>
            <Style Selector="^:checked /template/ #PART_MovingKnobs" x:SetterTargetType="Panel">
                <Setter Property="HorizontalAlignment" Value="Right"/>
            </Style>
            <Style Selector="^:checked /template/ #PART_KnobVisual" x:SetterTargetType="Border">
                <Setter Property="Background" Value="{DynamicResource BrushTextOnBrand}"/>
            </Style>
            <Style Selector="^:focus-visible /template/ #PART_Track" x:SetterTargetType="Border">
                <Setter Property="BorderThickness" Value="2"/>
            </Style>
        </ControlTheme>

    </TemplatedControl.Resources>

    <!-- CollapsibleSection — AGENTS §16.2: config sections collapse behind a
         chevron header. The chevron rotates on toggle (MotionDurationFast);
         reduced-motion collapses to zero via MotionDurationReduced. The header
         is a single brand-green bar spanning the full card width (4c.3 — no
         second background behind it); optional sections expose a white/light
         enable switch at the right of the bar (4c.2) and the HelpText InfoIcon
         sits at the far right (4b.3). -->
    <TemplatedControl.Template>
        <ControlTemplate>
            <Border Background="{DynamicResource BrushBackgroundPanel}"
                    BorderBrush="{DynamicResource BrushBorderDefault}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CornerRadiusM}">

                <StackPanel Spacing="0">

                    <Border Background="{DynamicResource BrushBrandGreen}"
                            CornerRadius="8,8,0,0"
                            Padding="{DynamicResource ThicknessSectionHeader}">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">

                            <!-- Collapse zone: chevron + title cover the bar up
                                 to the toggle/icon, so a click toggles. -->
                            <ToggleButton x:Name="PART_HeaderToggle"
                                          Grid.Column="0"
                                          Grid.ColumnSpan="2"
                                          IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Left"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="True"
                                          Padding="0">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Path x:Name="PART_Chevron"
                                          Data="M 6 9 L 12 15 L 18 9"
                                          Stroke="{DynamicResource BrushTextOnBrand}"
                                          StrokeThickness="2"
                                          StrokeLineCap="Round"
                                          StrokeJoin="Round"
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0"
                                          MinWidth="18"
                                          MinHeight="18">
                                        <Path.RenderTransform>
                                            <RotateTransform Angle="90">
                                                <RotateTransform.Transitions>
                                                    <Transitions>
                                                        <DoubleTransition Property="Angle"
                                                                          Duration="{DynamicResource MotionDurationFast}"/>
                                                    </Transitions>
                                                </RotateTransform.Transitions>
                                            </RotateTransform>
                                        </Path.RenderTransform>
                                    </Path>
                                    <TextBlock Text="{TemplateBinding Title}"
                                               FontSize="{DynamicResource FontSizeBody}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrushTextOnBrand}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </ToggleButton>

                            <!-- Optional-section enable switch: visible only when
                                 IsOptional is true; two-way bound to IsEnabledToggle. -->
                            <Grid Grid.Column="2"
                                  IsVisible="{TemplateBinding IsOptional}"
                                  VerticalAlignment="Center">
                                <ToggleSwitch x:Name="PART_OptionalToggle"
                                              Theme="{StaticResource HeaderToggleSwitch}"
                                              IsChecked="{TemplateBinding IsEnabledToggle, Mode=TwoWay}"
                                              OnContent=""
                                              OffContent=""
                                              ToolTip.Tip="Turn this section on to edit its fields."/>
                            </Grid>

                            <controls:InfoIcon Grid.Column="3"
                                               HelpText="{TemplateBinding HelpText}"
                                               HelpAnchor="collapsible-section"
                                               VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <ContentPresenter x:Name="PART_Body"
                                      Content="{TemplateBinding Content}"
                                      Margin="{DynamicResource ThicknessSpaceM}"
                                      IsVisible="{TemplateBinding IsExpanded}"/>

                </StackPanel>
            </Border>
        </ControlTemplate>
    </TemplatedControl.Template>
</TemplatedControl>