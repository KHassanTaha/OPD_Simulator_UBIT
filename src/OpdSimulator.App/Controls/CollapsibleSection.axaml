<TemplatedControl xmlns="https://github.com/avaloniaui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:controls="using:OpdSimulator.App.Controls"
                  x:Class="OpdSimulator.App.Controls.CollapsibleSection"
                  x:DataType="controls:CollapsibleSection">

    <!-- CollapsibleSection — AGENTS §16.2: config sections collapse behind a
         chevron header. The chevron rotates on toggle (MotionDurationFast);
         reduced-motion collapses to zero via MotionDurationReduced. The header
         is a brand-blue bar (4b.1/4b.2); optional sections expose an enable
         toggle at the right of the bar (4b.4) and the HelpText InfoIcon sits
         at the far right (4b.3). -->
    <TemplatedControl.Template>
        <ControlTemplate>
            <Border Background="{DynamicResource BrushBackgroundPanel}"
                    BorderBrush="{DynamicResource BrushBorderDefault}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CornerRadiusM}"
                    Padding="{DynamicResource ThicknessSpaceM}">

                <StackPanel Spacing="{DynamicResource SpaceS}">

                    <Border Background="{DynamicResource BrushBrandGreen}"
                            CornerRadius="{DynamicResource CornerRadiusS}"
                            Padding="{DynamicResource ThicknessSectionHeader}">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">

                            <!-- Collapse zone: chevron + title cover the bar up
                                 to the toggle/icon, so a click toggles. -->
                            <ToggleButton x:Name="PART_HeaderToggle"
                                          Grid.Column="0"
                                          Grid.ColumnSpan="2"
                                          IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Left"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="True"
                                          Padding="0">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Path x:Name="PART_Chevron"
                                          Data="M 6 9 L 12 15 L 18 9"
                                          Stroke="{DynamicResource BrushTextOnBrand}"
                                          StrokeThickness="2"
                                          StrokeLineCap="Round"
                                          StrokeJoin="Round"
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0"
                                          MinWidth="18"
                                          MinHeight="18">
                                        <Path.RenderTransform>
                                            <RotateTransform Angle="90">
                                                <RotateTransform.Transitions>
                                                    <Transitions>
                                                        <DoubleTransition Property="Angle"
                                                                          Duration="{DynamicResource MotionDurationFast}"/>
                                                    </Transitions>
                                                </RotateTransform.Transitions>
                                            </RotateTransform>
                                        </Path.RenderTransform>
                                    </Path>
                                    <TextBlock Text="{TemplateBinding Title}"
                                               FontSize="{DynamicResource FontSizeBody}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrushTextOnBrand}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </ToggleButton>

                            <!-- Optional-section enable toggle: visible only when
                                 IsOptional is true; two-way bound to IsEnabledToggle. -->
                            <Grid Grid.Column="2"
                                  IsVisible="{TemplateBinding IsOptional}"
                                  VerticalAlignment="Center">
                                <ToggleSwitch x:Name="PART_OptionalToggle"
                                              IsChecked="{TemplateBinding IsEnabledToggle, Mode=TwoWay}"
                                              OnContent=""
                                              OffContent=""
                                              ToolTip.Tip="Turn this section on to edit its fields."/>
                            </Grid>

                            <controls:InfoIcon Grid.Column="3"
                                               HelpText="{TemplateBinding HelpText}"
                                               HelpAnchor="collapsible-section"
                                               VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <ContentPresenter x:Name="PART_Body"
                                      Content="{TemplateBinding Content}"
                                      IsVisible="{TemplateBinding IsExpanded}"/>

                </StackPanel>
            </Border>
        </ControlTemplate>
    </TemplatedControl.Template>
</TemplatedControl>