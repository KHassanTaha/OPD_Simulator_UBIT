<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:OpdSimulator.App.Controls"
             xmlns:views="clr-namespace:OpdSimulator.App.Views"
             x:Class="OpdSimulator.App.Controls.StageRowControl"
             x:DataType="vm:StageRow"
             xmlns:vm="clr-namespace:OpdSimulator.App.ViewModels"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
      One stage row: the reusable unit for a stage in the Stages section (Phase 8K,
      D-150). It was an inline DataTemplate inside ConfigPanel.axaml until Phase 8K,
      which added three conditional spread inputs plus a Custom-notation state; a
      template that long stops being a template, and AGENTS.md 16.5 requires the
      reusable control. The row owns its own labels, tooltips, units and validation
      keys so a second stage list would render identically.
    -->
    <Border Classes="PanelCard"
            Margin="0,0,0,8"
            Padding="{DynamicResource ThicknessSpaceS}">
        <StackPanel Spacing="{DynamicResource SpaceS}">
            <TextBlock Text="Stage name"
                       FontSize="{DynamicResource FontSizeCaption}"
                       Foreground="{DynamicResource BrushTextSecondary}"/>
            <TextBox Text="{Binding StageName, Mode=TwoWay}"
                     Watermark="e.g., Reception"
                     ToolTip.Tip="Display name for this stage"/>
            <controls:ValidatedField Label="Servers"
                                     Watermark="e.g., 2"
                                     Tooltip="Number of parallel servers at this stage (≥ 1)"
                                     Value="{Binding Servers.Value, Mode=TwoWay}"
                                     HasError="{Binding Servers.HasError}"
                                     ErrorMessage="{Binding Servers.ErrorMessage}"
                                     HelpAnchor="servers"
                                     views:ConfigPanelValidation.ValidationKey="servers"/>

            <!-- Kendall shortcut (Phase 9A, D-229): the first letter is fixed by the
                 Model section's engine-wide arrival family, never chosen on a row.
                 The trailing digits are the server count. Advanced mode hides the
                 shortcut and reveals the service-family dropdown instead. -->
            <controls:DropdownField Label="Model"
                                         Placeholder="e.g., M/M/2"
                                         Tooltip="Kendall notation shortcut. The first letter follows the Model section's arrival family; choose the service family and server count here."
                                         Items="{Binding ModelOptions}"
                                         SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                                         IsVisible="{Binding !UseAdvancedSetup}"
                                         HelpAnchor="stage-model"/>
            <ToggleSwitch Content="Advanced"
                          IsChecked="{Binding UseAdvancedSetup, Mode=TwoWay}"
                          ToolTip.Tip="Set the arrival and service distribution families independently"/>

            <controls:DropdownField Label="Service distribution"
                                         Placeholder="e.g., Exponential"
                                         Tooltip="Distribution family for this stage's service times"
                                         Items="{Binding DistributionFamilies}"
                                         SelectedItem="{Binding ServiceFamily, Mode=TwoWay}"
                                         IsVisible="{Binding UseAdvancedSetup}"
                                         HelpAnchor="stage-service-distribution"/>

            <!-- Phase 8K (D-150): μ is the only location parameter for every family;
                 the field below adds spread only. Each family shows the one input it
                 needs, with its own label and unit, so a stale value from another
                 family can never be read as a valid one. -->
            <StackPanel Spacing="2"
                        IsVisible="{Binding NeedsShapeParameters}">
                <controls:ValidatedField Label="{Binding SpreadLabel}"
                                         Watermark="e.g., 0.4"
                                         Unit="{Binding SpreadUnit}"
                                         Tooltip="Spread of the service times. Shown for the Normal and Lognormal families only; the mean stays whatever μ you set."
                                         IsVisible="{Binding NeedsStdDev}"
                                         Value="{Binding ServiceStdDev, Mode=TwoWay}"
                                         HasError="{Binding HasInlineError}"
                                         ErrorMessage="{Binding InlineError}"
                                         HelpAnchor="stage-std-dev"
                                         views:ConfigPanelValidation.ValidationKey="stage-stddev"/>
                <controls:ValidatedField Label="Shape k"
                                         Watermark="e.g., 2"
                                         Tooltip="Shape k. Scale is derived as Mean / k."
                                         IsVisible="{Binding NeedsShape}"
                                         Value="{Binding ServiceShape, Mode=TwoWay}"
                                         HasError="{Binding HasInlineError}"
                                         ErrorMessage="{Binding InlineError}"
                                         HelpAnchor="stage-shape"
                                         views:ConfigPanelValidation.ValidationKey="stage-shape"/>
                <controls:ValidatedField Label="{Binding SpreadLabel}"
                                         Watermark="e.g., 0.5"
                                         Unit="{Binding SpreadUnit}"
                                         Tooltip="Half-width w. Min = Mean − w, Max = Mean + w."
                                         IsVisible="{Binding NeedsSpread}"
                                         Value="{Binding ServiceSpread, Mode=TwoWay}"
                                         HasError="{Binding HasInlineError}"
                                         ErrorMessage="{Binding InlineError}"
                                         HelpAnchor="stage-spread"
                                         views:ConfigPanelValidation.ValidationKey="stage-spread"/>
            </StackPanel>

            <StackPanel Spacing="2"
                        IsVisible="{Binding IsRateSourceVisible}">
                <TextBlock Text="Service rate μ"
                           FontSize="{DynamicResource FontSizeCaption}"
                           Foreground="{DynamicResource BrushTextSecondary}"/>
                <TextBlock Text="{Binding ServiceRateLabel}"
                           Classes="Caption"
                           TextWrapping="Wrap"
                           ToolTip.Tip="Source of this stage's effective service rate: fitted from the loaded data, entered manually, or missing"/>
            </StackPanel>

            <!-- 9A D-229: the derived per-stage inflow is visible on both paths.
                 It sits outside IsRateSourceVisible so manual mode still shows
                 where this stage's patients come from. -->
            <TextBlock Text="{Binding InflowLabel}"
                       Classes="Caption"
                       TextWrapping="Wrap"
                       ToolTip.Tip="ρᵢ = λᵢ / (cᵢ·μᵢ), where λᵢ is this stage's inflow after p_exit and p_bypass routing — not the front-door λ. The same patients move through the stages."
                       Foreground="{DynamicResource BrushTextSecondary}"/>

            <!-- Phase 9P (D-242): the editable per-stage μ is shown in both modes.
                 In fit mode its placeholder carries the fitted value, so a blank
                 field visibly means "use the data" and a typed one is an override
                 — which is what makes the owner's manual test edit reach the run. -->
            <controls:ValidatedField Label="{Binding MuLabel}"
                                     Watermark="{Binding MuPlaceholder}"
                                     Tooltip="Manual mean service rate for this stage, interpreted by the Parameter mode and Time unit. This is the only location parameter: the family above sets the spread."
                                     Unit="{Binding MuUnit}"
                                     IsVisible="{Binding IsMuVisible}"
                                     Value="{Binding MuValue, Mode=TwoWay}"
                                     HasError="{Binding MuHasError}"
                                     ErrorMessage="{Binding MuError}"
                                     HelpAnchor="stage-mu"
                                     views:ConfigPanelValidation.ValidationKey="stage-mu"/>

            <!-- The G/G/c verdict (Phase 8K, D-151). Shown only after a fit, and
                 cleared by the row when the family changes, so it always describes
                 the stage as it now stands. -->
            <Border Classes="PanelCard"
                    Padding="{DynamicResource ThicknessSpaceS}"
                    IsVisible="{Binding AutoFitBadge, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <StackPanel Spacing="2">
                    <TextBlock Text="G/G/c auto-fit"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource BrushTextSecondary}"/>
                    <TextBlock Text="{Binding AutoFitBadge}"
                               TextWrapping="Wrap"
                               ToolTip.Tip="The family the fitter chose for this stage's observed service times, with its AIC and the chi-square p-value. Change the family by hand and this verdict is cleared."/>
                </StackPanel>
            </Border>


             <!-- Phase 9C (D-232): what the load decided for this stage, and any
                  departure from it, stay beside the controls they describe. -->
             <TextBlock Text="{Binding FitDisclosure}"
                        Classes="Caption"
                        TextWrapping="Wrap"
                        Foreground="{DynamicResource BrushTextSecondary}"
                        ToolTip.Tip="The service family the uploaded data chose for this stage on load."
                        IsVisible="{Binding FitDisclosure, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
             <TextBlock Text="{Binding FitOverrideWarning}"
                        Classes="Caption"
                        TextWrapping="Wrap"
                        Foreground="{DynamicResource BrushError}"
                        ToolTip.Tip="This stage's service family deviates from the uploaded data's best fit."
                        IsVisible="{Binding FitOverrideWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
             <TextBlock Text="{Binding DataCoverageWarning}"
                        Classes="Caption"
                        TextWrapping="Wrap"
                        Foreground="{DynamicResource BrushError}"
                        ToolTip.Tip="This stage is not covered by the loaded file, so no fitted service rate exists for it."
                        IsVisible="{Binding DataCoverageWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
             <TextBlock Text="{Binding MuOverrideWarning}"
                        Classes="Caption"
                        TextWrapping="Wrap"
                        Foreground="{DynamicResource BrushError}"
                        ToolTip.Tip="This stage's typed μ deviates from the uploaded data's fitted value."
                        IsVisible="{Binding MuOverrideWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
             <Button Content="Use the data fit"
                     Command="{Binding UseDataFitCommand}"
                     Classes="GhostButton"
                     ToolTip.Tip="Restore this stage's fitted family and spread and clear the μ override."
                     IsVisible="{Binding HasDataFit}"/>
            <!-- Row-level error display for messages that belong to no visible input.
                 A spread error already appears under its own field, so it is not
                 repeated here; an auto-fit refusal has no field of its own and would
                 otherwise be invisible on a stage with no spread input. One message,
                 one channel, shown once (Phase 8K, D-151). -->
            <StackPanel Spacing="2"
                        IsVisible="{Binding ShowRowLevelError}">
                <TextBlock Text="&#x26A0;"
                           Foreground="{DynamicResource BrushError}"
                           FontSize="{DynamicResource FontSizeBody}"/>
                <TextBlock Text="{Binding InlineError}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource BrushError}"
                           FontSize="{DynamicResource FontSizeCaption}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
