<TemplatedControl xmlns="https://github.com/avaloniaui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:controls="using:OpdSimulator.App.Controls"
                  xmlns:models="using:OpdSimulator.App.Controls"
                  x:Class="OpdSimulator.App.Controls.DataPreviewTable"
                  x:DataType="controls:DataPreviewTable">

    <!-- DataPreviewTable — FR-UI-20 read-only preview. Rows render in a
         virtualising ListBox (10k rows scroll smoothly); column headers come
         from the loaded file and cycle asc -> desc -> original on click; cells
         are SelectableTextBlock so values can be Ctrl+C'd; invalid rows are
         red-flagged with a reason tooltip; load failures swap the table for an
         ErrorBanner. -->
    <TemplatedControl.Template>
        <ControlTemplate>
            <Grid x:Name="TableArea"
                  RowDefinitions="Auto,*"
                  IsVisible="False">

                <controls:ErrorBanner x:Name="LoadErrorBanner"
                                      IsVisible="False"/>
                <TextBlock x:Name="NoRowsText"
                           Text="No valid rows in the loaded file."
                           Classes="Caption"
                           Foreground="{DynamicResource BrushTextMuted}"
                           Padding="{DynamicResource ThicknessSpaceM}"/>

                <ScrollViewer Grid.Row="0"
                              x:Name="HeaderScroller"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="HeaderPanel"
                                Orientation="Horizontal"
                                Margin="0,0,0,4"/>
                </ScrollViewer>

                <Border Grid.Row="1"
                        BorderBrush="{DynamicResource BrushBorderDefault}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource CornerRadiusS}"
                        Background="{DynamicResource BrushBackgroundPanel}">
                    <ListBox x:Name="RowRepeater"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <!-- Phase 8Q.6 / FR-UI-17. The model has carried
                                 RowBackground, RowBorderBrush and
                                 RowBorderThickness since D-080, but nothing bound
                                 them here, so a row the validator rejected rendered
                                 identically to a good one. The three bindings below
                                 are the whole fix; the rest is the inline issue
                                 indicator FR-UI-17 names (red border + icon +
                                 tooltip with the specific reason).

                                 The indicator sits in its own fixed-width leading
                                 slot rather than being appended to the cell strip,
                                 because the cells are positional Width doubles: a
                                 variable-width icon inside that strip would shift
                                 every column of an invalid row rightwards and break
                                 alignment against the headers. Rebuild() adds a
                                 matching spacer to HeaderPanel so the gutter does
                                 not shift the data columns either. -->
                            <DataTemplate x:DataType="models:PreviewRow">
                                <Border Background="{Binding RowBackground}"
                                        BorderBrush="{Binding RowBorderBrush}"
                                        BorderThickness="{Binding RowBorderThickness}"
                                        ToolTip.Tip="{Binding InvalidReason}">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding IssueGlyph}"
                                                   Width="{x:Static controls:DataPreviewTable.IndicatorGutter}"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   Foreground="{Binding RowBorderBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   ToolTip.Tip="{Binding InvalidReason}"
                                                   AutomationProperties.Name="{Binding InvalidReason, StringFormat=Validation issue: {0}}"/>
                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:PreviewCell">
                                                    <SelectableTextBlock Text="{Binding Text}"
                                                                             Width="{Binding Width}"
                                                                             TextTrimming="CharacterEllipsis"
                                                                             FontFamily="{DynamicResource FontMono}"
                                                                             FontSize="{DynamicResource FontSizeCaption}"
                                                                             Padding="4,2"
                                                                             Foreground="{DynamicResource BrushTextPrimary}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

            </Grid>
        </ControlTemplate>
    </TemplatedControl.Template>
</TemplatedControl>