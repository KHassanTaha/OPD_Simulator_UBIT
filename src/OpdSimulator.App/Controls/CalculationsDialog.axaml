<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpdSimulator.App.Controls.CalculationsDialog"
        Width="800"
        MinWidth="640"
        MaxWidth="1200"
        MinHeight="400"
        MaxHeight="800"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        ShowInTaskbar="False"
        Background="{DynamicResource BrushBackgroundWindow}">

    <!-- CalculationsDialog — Phase 8N, D-165 / D-166.
         A dedicated Window, NOT a ThemedDialog: the confirm/error dialogs on
         ThemedDialog are still 440px wide by design, and its four other callers
         (ConfigPanelViewModel, ConfigPanel, ControlsDemo, and the old
         calculations path) must not change size because this one was too narrow.

         D-166: every size below is declared HERE, in the control's own XAML.
         No call site may set Width/MinWidth/MaxWidth. The Phase 8M screenshot test
         set Width = 760 while production ran at 440, so the test rendered a dialog
         no user could ever see. Sizing now lives in exactly one place.

         SizeToContent="Height" plus MaxHeight means short content gives a short
         dialog and long content grows until MaxHeight and then scrolls. There is no
         fixed Height, so a six-stage run can never push the buttons out of reach. -->
    <Border CornerRadius="{DynamicResource CornerRadiusL}"
            Padding="{DynamicResource ThicknessSpaceL}">
        <StackPanel Spacing="{DynamicResource SpaceM}">

            <TextBlock x:Name="DialogTitle"
                       Text="{Binding $parent[Window].Title}"
                       FontSize="{DynamicResource FontSizeTitle}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushTextPrimary}"/>

            <!-- The rows are built in code-behind and placed here. They are laid out
                 in a Grid (Auto,*) rather than a StackPanel so the label column takes
                 only the width its longest label needs and every remaining pixel goes
                 to the value — the two columns were sharing one monospace text block
                 before, which is why the values were cut off. -->
            <ScrollViewer x:Name="RowsHost"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ContentControl x:Name="RowsContainer"/>
            </ScrollViewer>

            <!-- Column 0 is a spacer that pushes the actions right (AGENTS §16.2). -->
            <Grid ColumnDefinitions="*,Auto,Auto"
                  ColumnSpacing="{DynamicResource SpaceS}">
                <Button x:Name="CopyButton"
                        Grid.Column="1"
                        Classes="GhostButton"
                        Click="OnCopyClick"
                        Content="Copy"
                        MinWidth="100"
                        Padding="{DynamicResource ThicknessControlPadding}"
                        HorizontalAlignment="Right"
                        IsVisible="False"/>
                <Button x:Name="CloseButton"
                        Grid.Column="2"
                        Classes="PrimaryButton"
                        Click="OnCloseClick"
                        Content="Close"
                        MinWidth="100"
                        Padding="{DynamicResource ThicknessControlPadding}"
                        HorizontalAlignment="Right"
                        IsDefault="True"/>
            </Grid>

        </StackPanel>
    </Border>
</Window>
