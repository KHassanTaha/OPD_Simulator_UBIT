<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpdSimulator.App.Controls.CalculationsDialog"
        Width="800"
        Height="800"
        MinWidth="640"
        MaxWidth="1200"
        MinHeight="400"
        MaxHeight="800"
        SizeToContent="Manual"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        ShowInTaskbar="False"
        Background="{DynamicResource BrushBackgroundWindow}">

    <!-- CalculationsDialog — Phase 8N, D-165 / D-166; footer pinned in D-169.

         A dedicated Window, NOT a ThemedDialog: the confirm/error dialogs on
         ThemedDialog are still 440px wide by design, and its four other callers
         (ConfigPanelViewModel, ConfigPanel, ControlsDemo, and the old
         calculations path) must not change size because this one was too narrow.

         D-166: every size below is declared HERE, in the control's own XAML.
         No call site may set Width/MinWidth/MaxWidth. The Phase 8M screenshot test
         set Width = 760 while production ran at 440, so the test rendered a dialog
         no user could ever see. Sizing now lives in exactly one place.

         D-169 — why the root is a three-row Grid. This was a vertical StackPanel
         (title, ScrollViewer, footer) with SizeToContent="Height". A vertical
         StackPanel gives every child its DESIRED height and never shrinks one to
         fit, so once the children wanted more room than the window had, the excess
         spilled below the bottom edge and the LAST child — the footer — went with
         it. Shrinking the window did not scroll the body; it deleted the buttons.
         Three rows say the same thing properly:
           row 0  Auto   title, its natural height
           row 1  *      the ScrollViewer, absorbing whatever is left
           row 2  Auto   the footer, its natural height, always present
         The * row is bounded by the Window, which is what replaces the MaxHeight
         the ScrollViewer never had — so VerticalScrollBarVisibility="Auto" finally
         has overflow to react to. And SizeToContent is Manual with an explicit
         Height, because a window that sizes itself from its content cannot be
         resized by the user: the drag is contested on the next layout pass. -->
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Row 0: the title, padded for itself now that it no longer shares an
             outer Border with the footer. -->
        <Border Grid.Row="0"
                Padding="{DynamicResource ThicknessSpaceL}">
            <TextBlock x:Name="DialogTitle"
                       Text="{Binding $parent[Window].Title}"
                       FontSize="{DynamicResource FontSizeTitle}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushTextPrimary}"/>
        </Border>

        <!-- Row 1: the body. The rows are built in code-behind and placed here.
             They are laid out in a Grid (Auto,*) rather than a StackPanel so the
             label column takes only the width its longest label needs and every
             remaining pixel goes to the value — the two columns were sharing one
             monospace text block before, which is why the values were cut off.

             D-170: the inset lives on a content Border, not on the ScrollViewer,
             and the trailing spacer is a real element inside that content. Both
             matter for the same measured reason D-142 recorded for the config
             panel: ScrollViewer.Padding is NOT part of the scrollable extent, so
             its bottom padding is space the user can never scroll to — which is
             why the last lines sat under the footer. Border.Padding IS part of
             the desired size and scrolls. The spacer exists because padding alone
             was not enough at the bottom edge. -->
        <ScrollViewer x:Name="RowsHost"
                      Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <Border Padding="{DynamicResource ThicknessSpaceL}">
                <StackPanel>
                    <ContentControl x:Name="RowsContainer"/>

                    <!-- The bottom buffer. The last body row must be able to travel
                         clear of the footer's top edge, so the content ends in a
                         real element the extent accounts for. Height is the SpaceL
                         token, so it restyles with the theme (§16.3). -->
                    <Border x:Name="BottomBuffer"
                            Height="{DynamicResource SpaceL}"/>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Row 2: the footer. A SIBLING of the ScrollViewer, never its child, so
             scrolling the body can never take the actions out of reach. Column 0 of
             the inner Grid is a spacer that pushes the actions right (§16.2). -->
        <Border Grid.Row="2"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource BrushBorderDefault}"
                Padding="{DynamicResource ThicknessSpaceM}">
            <Grid ColumnDefinitions="*,Auto,Auto"
                  ColumnSpacing="{DynamicResource SpaceS}">
                <Button x:Name="CopyButton"
                        Grid.Column="1"
                        Classes="GhostButton"
                        Click="OnCopyClick"
                        Content="Copy"
                        MinWidth="100"
                        Padding="{DynamicResource ThicknessControlPadding}"
                        HorizontalAlignment="Right"
                        IsVisible="False"/>
                <Button x:Name="CloseButton"
                        Grid.Column="2"
                        Classes="PrimaryButton"
                        Click="OnCloseClick"
                        Content="Close"
                        MinWidth="100"
                        Padding="{DynamicResource ThicknessControlPadding}"
                        HorizontalAlignment="Right"
                        IsDefault="True"/>
            </Grid>
        </Border>

    </Grid>
</Window>
