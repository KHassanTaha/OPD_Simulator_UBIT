<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:OpdSimulator.App.Controls"
             x:Name="root"
             x:Class="OpdSimulator.App.Controls.ValidatedField">

    <!-- Label + input + optional help + inline error (FR-UI-17). The field's
         '?' delegates to InfoIcon; error state is toggled in code-behind. -->
    <StackPanel Spacing="4">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock x:Name="LabelText"
                       FontSize="{DynamicResource FontSizeCaption}"
                       Foreground="{DynamicResource BrushTextSecondary}"
                       Text="{Binding #root.Label}"/>
            <controls:InfoIcon x:Name="HelpIcon"
                               Grid.Column="1"
                               HelpAnchor="{Binding #root.HelpAnchor}"
                               HelpTip="{Binding #root.HelpTip}"
                               IsVisible="{Binding #root.ShowHelp}"/>
        </Grid>

        <Border x:Name="FieldBorder"
                BorderBrush="{DynamicResource BrushBorderDefault}"
                BorderThickness="{DynamicResource ThicknessFieldBorder}"
                Background="{DynamicResource BrushBackgroundPanel}"
                CornerRadius="{DynamicResource CornerRadiusSmall}">
            <ContentPresenter Content="{Binding #root.Content}"/>
        </Border>

        <Grid x:Name="ErrorRow" ColumnDefinitions="Auto,*" IsVisible="False">
            <TextBlock x:Name="ErrorIcon"
                       FontSize="{DynamicResource FontSizeBody}"
                       Foreground="{DynamicResource BrushError}"
                       VerticalAlignment="Top"
                       Text="&#xE9CE;"/> <!-- warning triangle -->
            <TextBlock x:Name="ErrorText"
                       Grid.Column="1"
                       Margin="4,0,0,0"
                       TextWrapping="Wrap"
                       FontSize="{DynamicResource FontSizeCaption}"
                       Foreground="{DynamicResource BrushError}"/>
        </Grid>
    </StackPanel>
</UserControl>